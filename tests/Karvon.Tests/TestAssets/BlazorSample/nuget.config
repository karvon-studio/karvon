<?xml version="1.0" encoding="utf-8"?>
<!-- The tests restore from nuget.org only: never from the feeds of the machine they run on (private ones may not be reachable). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
