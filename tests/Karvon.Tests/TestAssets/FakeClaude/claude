#!/usr/bin/env python3
"""A stand-in for the Claude Code CLI in stream-json mode, for Karvon's tests.

It speaks the same JSON lines as `claude --input-format stream-json --output-format stream-json`: it answers
control requests, streams text, asks for permission with can_use_tool, and ends turns with a result. Every line
it receives (and its arguments) is appended to <workspace>.fake-claude.log so tests can check what Karvon sent. What it does
for a prompt depends on a keyword in it: endpoint (the README screenshot), agent, write, edit, bash, ask, plan,
background, longjob (a command in the background, which ends later), slow, phone (a prompt then comes from claude.ai,
with Remote Control on), bridge (Remote Control drops),
karvontools (Karvon's own MCP server: a query, a change, a destructive change); anything else gets a Markdown answer.
"""
import json
import os
import re
import sys
import threading
import time
import uuid

ARGS = sys.argv[1:]
CONFIG = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".fake-claude")
MCP_FILE = os.path.join(CONFIG, "fake-mcp.json")
STATE = {"effort": "xhigh", "disabled": set(), "authenticated": set(), "reconnected": set(), "remote": False, "hooks": {},
         "mode": ARGS[ARGS.index("--permission-mode") + 1] if "--permission-mode" in ARGS else "default"}


def added_servers():
    try:
        with open(MCP_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


# `claude mcp add [--scope s] [--transport t] name (url | -- command args...)` records the server and exits.
if ARGS[:2] == ["mcp", "add"]:
    rest, scope, transport = ARGS[2:], "local", "stdio"
    while rest and rest[0].startswith("--") and rest[0] != "--":
        if rest[0] == "--scope":
            scope = rest[1]
        elif rest[0] == "--transport":
            transport = rest[1]
        rest = rest[2:]
    if not rest:
        print("error: missing server name", file=sys.stderr)
        sys.exit(1)
    name, target = rest[0], [a for a in rest[1:] if a != "--"]
    servers = [s for s in added_servers() if s["name"] != name]
    servers.append({"name": name, "scope": scope, "type": transport, "target": target})
    os.makedirs(CONFIG, exist_ok=True)
    with open(MCP_FILE, "w", newline="") as f:
        json.dump(servers, f)
    print(f"Added {transport} MCP server {name} to {scope} config")
    sys.exit(0)

# `claude -p ...` (a one-shot prompt on stdin, as Git Changes' commit message): the prompt is kept next to the config for
# the tests, and the answer is a message wrapped the way a model might wrap it, with a trailer Karvon must remove.
if ARGS[:1] == ["-p"]:
    prompt = sys.stdin.read()
    os.makedirs(CONFIG, exist_ok=True)
    with open(os.path.join(CONFIG, "last-print.json"), "w", newline="") as f:
        json.dump({"args": ARGS, "prompt": prompt, "cwd": os.getcwd(), "claudecode": os.environ.get("CLAUDECODE")}, f)
    print("```\nAdd the multi-repository commit panel\n\nLists every repository of the solution.\nCo-Authored-By: Claude <noreply@anthropic.com>\n```")
    sys.exit(0)
CWD = os.getcwd()
# A workspace with a .fake-claude-sessions counter gives each new conversation an id of its own (several run at once).
SESSIONS = os.path.join(CWD, ".fake-claude-sessions")
if "--resume" in ARGS:
    SESSION = ARGS[ARGS.index("--resume") + 1]
elif os.path.exists(SESSIONS):
    with open(SESSIONS) as f:
        number = int(f.read().strip() or "0") + 1
    with open(SESSIONS, "w", newline="") as f:
        f.write(str(number))
    SESSION = f"fake-session-{number}"
else:
    SESSION = "fake-session-1"
# Test workspaces are named karvon-claude-*; their log sits next to them so parallel tests never share one.
LOG = os.path.join(os.path.dirname(CWD), os.path.basename(CWD) + ".fake-claude.log") if os.path.basename(CWD).startswith("karvon-claude-") else None
counter = [0]


def log(kind, data):
    if not LOG:
        return
    try:
        with open(LOG, "a") as f:
            f.write(json.dumps({"kind": kind, "data": data}) + "\n")
    except OSError:
        pass


OUT = threading.Lock()


def out(obj):
    with OUT:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()


def read():
    line = sys.stdin.readline()
    if not line:
        sys.exit(0)
    message = json.loads(line)
    log("in", message)
    return message


def handle_control(message):
    request = message["request"]
    subtype = request.get("subtype")
    response = {}
    if subtype == "initialize":
        STATE["hooks"] = request.get("hooks") or {}
        response = {
            "commands": [
                {"name": "compact", "description": "Clear history but keep a summary", "argumentHint": ""},
                {"name": "review", "description": "Review a pull request", "argumentHint": ""},
            ],
            "models": [
                {"value": "default", "displayName": "Default (recommended)", "description": "Fake default", "supportsEffort": True,
                 "supportedEffortLevels": ["low", "medium", "high", "xhigh", "max"], "supportsAutoMode": True},
                {"value": "haiku", "displayName": "Haiku", "description": "Fast", "supportsEffort": True,
                 "supportedEffortLevels": ["low", "medium", "high"], "supportsAutoMode": False},
            ],
            "account": {"email": "tests@example.invalid", "organization": "Tests Org", "subscriptionType": "Claude Pro", "apiProvider": "firstParty"},
            "current_permission_mode": "default",
            "remote_control_available": True,
        }
    elif subtype == "set_permission_mode":
        mode = request.get("mode")
        # As Claude Code 2.1.304 answers: bypass only when the CLI was started allowing it.
        if mode == "bypassPermissions" and "--allow-dangerously-skip-permissions" not in ARGS:
            out({"type": "control_response", "response": {"subtype": "error", "request_id": message["request_id"], "error_code": "bypass_not_launched",
                 "error": "Cannot set permission mode to bypassPermissions because the session was not launched with --dangerously-skip-permissions"}})
            return subtype
        response = {"mode": mode}
        STATE["mode"] = mode
        out({"type": "system", "subtype": "status", "status": None, "permissionMode": mode, "uuid": str(uuid.uuid4()), "session_id": SESSION})
    elif subtype == "remote_control":
        STATE["remote"] = bool(request.get("enabled"))
        if STATE["remote"]:
            response = {"session_url": f"https://claude.ai/code/session_{SESSION}", "connect_url": f"https://claude.ai/code/session_{SESSION}?connect=1",
                        "bridge_session_id": f"session_{SESSION}", "bridge_epoch": 1}
    elif subtype == "get_settings":
        response = {"effective": {"model": "opus"}, "sources": [], "applied": {"model": "claude-opus-5-5", "effort": STATE["effort"]}}
    elif subtype == "apply_flag_settings":
        STATE["effort"] = request.get("settings", {}).get("effortLevel", STATE["effort"])
        response = {}
    elif subtype == "get_usage":
        # The shape of Claude Code 2.1.300's get_usage (values made up).
        response = {
            "subscription_type": "pro", "rate_limits_available": True,
            "rate_limits": {
                "five_hour": {"utilization": 60, "resets_at": "2099-01-01T00:00:00+00:00"},
                "seven_day": {"utilization": 74, "resets_at": "2099-01-03T00:00:00+00:00"},
                "limits": [
                    {"kind": "session", "group": "session", "percent": 60, "resets_at": "2099-01-01T00:00:00+00:00", "severity": "normal", "scope": None},
                    {"kind": "weekly_all", "group": "weekly", "percent": 84, "resets_at": "2099-01-03T00:00:00+00:00", "severity": "normal", "scope": None},
                    {"kind": "weekly_scoped", "group": "weekly", "percent": 0, "resets_at": "2099-01-03T00:00:00+00:00", "severity": "normal",
                     "scope": {"model": {"display_name": "Fable", "id": None}, "surface": None}},
                ],
            },
            "behaviors": {
                "day": {"request_count": 3044, "session_count": 11, "behaviors": [{"key": "long_context", "pct": 97, "count": 2721}, {"key": "cron", "pct": 80, "count": 3}],
                        "skills": [{"name": "review", "pct": 2}], "agents": [], "plugins": [], "mcp_servers": []},
                "week": {"request_count": 10455, "session_count": 21, "behaviors": [{"key": "cron", "pct": 96, "count": 9}], "skills": [], "agents": [], "plugins": [], "mcp_servers": []},
            },
        }
    elif subtype == "mcp_status":
        servers = [
            {"name": "hamyon", "status": "connected" if "hamyon" in STATE["authenticated"] else "needs-auth", "scope": "user", "source": "user", "config": {"type": "http"}},
            {"name": "rea", "status": "disabled" if "rea" in STATE["disabled"] else "connected", "scope": "user", "source": "user", "config": {"type": "stdio"}},
            {"name": "broken", "status": "connected" if "broken" in STATE["reconnected"] else "failed", "scope": "local", "source": "local", "config": {"type": "stdio"}},
            {"name": "claude.ai Docs", "status": "connected", "scope": "claudeai", "source": "claudeai", "config": {"type": "claudeai-proxy"}},
        ]
        servers += [{"name": a["name"], "status": "connected", "scope": a["scope"], "source": a["scope"], "config": {"type": a["type"]}} for a in added_servers()]
        response = {"mcpServers": servers}
    elif subtype == "mcp_toggle":
        name = request.get("serverName")
        if request.get("enabled"):
            STATE["disabled"].discard(name)
        else:
            STATE["disabled"].add(name)
    elif subtype == "mcp_reconnect":
        STATE["reconnected"].add(request.get("serverName"))
    elif subtype == "mcp_authenticate":
        STATE["authenticated"].add(request.get("serverName"))
        response = {"authUrl": "https://auth.example.invalid/authorize?client=karvon", "requiresUserAction": True}
    out({"type": "control_response", "response": {"subtype": "success", "request_id": message["request_id"], "response": response}})
    if subtype == "remote_control" and STATE["remote"]:
        out({"type": "system", "subtype": "bridge_state", "state": "connected", "bridge_epoch": 1, "uuid": str(uuid.uuid4()), "session_id": SESSION})
    return subtype


def next_id():
    counter[0] += 1
    return f"msg_{counter[0]}"


def event(mid, ev):
    out({"type": "stream_event", "event": ev, "api_message_id": mid, "parent_tool_use_id": None, "session_id": SESSION})


def stream_text(text):
    mid = next_id()
    event(mid, {"type": "message_start", "message": {"id": mid}})
    event(mid, {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}})
    for i in range(0, len(text), 7):
        event(mid, {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": text[i:i + 7]}})
    event(mid, {"type": "content_block_stop", "index": 0})
    event(mid, {"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {"output_tokens": 42}})
    out({"type": "assistant", "message": {"id": mid, "role": "assistant", "content": [{"type": "text", "text": text}]},
         "parent_tool_use_id": None, "session_id": SESSION})


def think(text):
    mid = next_id()
    event(mid, {"type": "content_block_start", "index": 0, "content_block": {"type": "thinking", "thinking": ""}})
    event(mid, {"type": "content_block_delta", "index": 0, "delta": {"type": "thinking_delta", "thinking": text}})
    out({"type": "assistant", "message": {"id": mid, "role": "assistant", "content": [{"type": "thinking", "thinking": text}]},
         "parent_tool_use_id": None, "session_id": SESSION})


def tool_use(tool_id, name, tool_input):
    out({"type": "assistant", "message": {"id": next_id(), "role": "assistant",
         "content": [{"type": "tool_use", "id": tool_id, "name": name, "input": tool_input}]},
         "parent_tool_use_id": None, "session_id": SESSION})


def tool_result(tool_id, content, is_error=False):
    out({"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": tool_id, "content": content, "is_error": is_error}]},
        "parent_tool_use_id": None, "session_id": SESSION})


def result(text, subtype="success", is_error=False):
    # What Claude Code 2.1.300 reports after a model call: the plan's limits, then the turn with its token usage.
    out({"type": "rate_limit_event", "session_id": SESSION, "rate_limit_info": {"status": "allowed", "unifiedWindows": {
        "five_hour": {"utilization": 0.64, "resetsAt": 1792073400}, "seven_day": {"utilization": 0.21, "resetsAt": 1792418400}}}})
    out({"type": "result", "subtype": subtype, "is_error": is_error, "duration_ms": 1200, "total_cost_usd": 0.01,
         "result": text, "session_id": SESSION, "usage": {"input_tokens": 2, "cache_creation_input_tokens": 10599,
         "cache_read_input_tokens": 14166, "output_tokens": 480, "iterations": [{"input_tokens": 2, "output_tokens": 480,
         "cache_read_input_tokens": 14166, "cache_creation_input_tokens": 10599}]}})


def permission(tool, tool_input, suggestions, tool_id):
    request_id = str(uuid.uuid4())
    out({"type": "control_request", "request_id": request_id, "request": {
        "subtype": "can_use_tool", "tool_name": tool, "display_name": tool, "input": tool_input,
        "permission_suggestions": suggestions, "tool_use_id": tool_id}})
    while True:
        message = read()
        if message.get("type") == "control_response" and message["response"]["request_id"] == request_id:
            decision = message["response"]["response"]
            log("decision", decision)
            return decision
        if message.get("type") == "control_request":
            handle_control(message)


def pre_tool_use(tool, tool_input, tool_id):
    """The host's PreToolUse hooks for the tool (as the Agent SDK's callbacks); the first denial, or None."""
    for matcher in STATE["hooks"].get("PreToolUse", []):
        # A matcher is a regular expression over the tool's name, as Claude Code reads it ("Edit|Write").
        if matcher.get("matcher") is not None and not re.fullmatch(matcher["matcher"], tool):
            continue
        for callback in matcher.get("hookCallbackIds", []):
            request_id = str(uuid.uuid4())
            out({"type": "control_request", "request_id": request_id, "request": {"subtype": "hook_callback", "callback_id": callback, "input": {
                "session_id": SESSION, "cwd": CWD, "hook_event_name": "PreToolUse", "tool_name": tool, "tool_input": tool_input, "tool_use_id": tool_id},
                "tool_use_id": tool_id}})
            while True:
                reply = read()
                if reply.get("type") == "control_response" and reply["response"]["request_id"] == request_id:
                    answer = reply["response"]["response"]
                    log("hook", answer)
                    specific = answer.get("hookSpecificOutput") or {}
                    if specific.get("permissionDecision") == "deny":
                        return specific.get("permissionDecisionReason", "denied")
                    break
                if reply.get("type") == "control_request":
                    handle_control(reply)
    return None


def allowed(decision):
    return decision.get("behavior") == "allow"


def mcp(server, method, params=None, notify=False):
    """A JSON-RPC message for an "sdk" MCP server (one the host serves), as Claude Code sends them; its answer is logged."""
    request_id = str(uuid.uuid4())
    message = {"jsonrpc": "2.0", "method": method}
    if params is not None:
        message["params"] = params
    if not notify:
        message["id"] = counter[0] = counter[0] + 1
    out({"type": "control_request", "request_id": request_id, "request": {"subtype": "mcp_message", "server_name": server, "message": message}})
    while True:
        reply = read()
        if reply.get("type") == "control_response" and reply["response"]["request_id"] == request_id:
            answer = reply["response"]["response"]["mcp_response"]
            log("mcp", {"method": method, "response": answer})
            return answer
        if reply.get("type") == "control_request":
            handle_control(reply)


def sdk_servers():
    if "--mcp-config" not in ARGS:
        return []
    config = json.loads(ARGS[ARGS.index("--mcp-config") + 1])
    return [name for name, server in config.get("mcpServers", {}).items() if server.get("type") == "sdk"]


def karvon_tool(tool_id, name, tool_input):
    """A call to one of Karvon's tools: asked as any tool (Karvon answers reads itself), then run through its server."""
    full = "mcp__karvon__" + name
    tool_use(tool_id, full, tool_input)
    decision = permission(full, tool_input, [{"type": "addRules", "rules": [{"toolName": full}], "behavior": "allow", "destination": "localSettings"}], tool_id)
    if not allowed(decision):
        tool_result(tool_id, decision.get("message", "denied"), True)
        return None
    answer = mcp("karvon", "tools/call", {"name": name, "arguments": tool_input})
    text = answer["result"]["content"][0]["text"]
    tool_result(tool_id, text, answer["result"].get("isError", False))
    return text


def subagent_step(parent, tool_id, name, tool_input, result_text):
    out({"type": "assistant", "message": {"id": next_id(), "role": "assistant",
         "content": [{"type": "tool_use", "id": tool_id, "name": name, "input": tool_input}]},
         "parent_tool_use_id": parent, "session_id": SESSION})
    out({"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": tool_id, "content": result_text}]},
         "parent_tool_use_id": parent, "session_id": SESSION})


def command(text):
    """Slash commands run locally and answer with a synthetic assistant message, as Claude Code 2.1.300 does."""
    name, _, arg = text[1:].partition(" ")
    if name == "compact":
        compact(arg)
        return
    replies = {
        "effort": f"Set effort level to {arg} (this session only)" if arg else "Usage: /effort <low|medium|high|xhigh|max|auto>",
        "model": f"Set model to {arg}" if arg else "Current model: `Fake`",
        "context": "## Context Usage\n\n| Category | Tokens |\n|---|---|\n| Messages | 1.3k |",
    }
    reply = replies.get(name, f"Unknown command: /{name}")
    out({"type": "assistant", "message": {"id": next_id(), "model": "<synthetic>", "role": "assistant", "content": [{"type": "text", "text": reply}]},
         "parent_tool_use_id": None, "session_id": SESSION})
    result(reply)


def compact(arg):
    """/compact as Claude Code 2.1.312 sends it: compacting, then how it ended. A test holds it there while a
    .fake-claude-compact-hold file is there; "/compact fail" fails."""
    system("status", status="compacting")
    hold = os.path.join(CWD, ".fake-claude-compact-hold")
    while os.path.exists(hold):
        time.sleep(0.05)
    if arg == "fail":
        system("status", status=None, compact_result="failed", compact_error="Not enough messages to compact.")
        result("")
        return
    system("status", status=None, compact_result="success")
    system("compact_boundary", compact_metadata={"trigger": "manual", "pre_tokens": 25000})
    out({"type": "user", "message": {"role": "user", "content": "The conversation so far: the build was fixed."},
         "isCompactSummary": True, "parent_tool_use_id": None, "session_id": SESSION})
    result("")


def demo():
    """The README screenshot (Screenshots.cs): a read, a todo list and an edit waiting for approval."""
    path = os.path.join(CWD, "Web", "Program.cs")
    with open(path) as f:
        text = f.read()
    think("The endpoints are mapped in Web/Program.cs and TodoStore already has Remove, so only the mapping is missing.")
    tool_use("toolu_read", "Read", {"file_path": path})
    tool_result("toolu_read", "\n".join(f"{i:6}\t{line}" for i, line in enumerate(text.splitlines(), 1)))
    tool_use("toolu_todo", "TodoWrite", {"todos": [
        {"content": "Find where the endpoints are mapped", "status": "completed", "activeForm": "Finding the endpoints"},
        {"content": "Map DELETE /todos/{id}", "status": "in_progress", "activeForm": "Mapping DELETE /todos/{id}"},
        {"content": "Build the solution", "status": "pending", "activeForm": "Building the solution"}]})
    tool_result("toolu_todo", "Todos have been modified successfully")
    stream_text("I'll map `DELETE /todos/{id}` next to the other endpoints. It answers **204** when the todo is removed "
                "and **404** when the id is unknown.")
    old = next(line for line in text.splitlines() if "MapPost" in line)
    new = old + "\napp.MapDelete(\"/todos/{id:int}\", (TodoStore todos, int id) =>\n    todos.Remove(id) ? Results.NoContent() : Results.NotFound());"
    tool_input = {"file_path": path, "old_string": old, "new_string": new}
    tool_use("toolu_edit", "Edit", tool_input)
    decision = permission("Edit", tool_input, [{"type": "setMode", "mode": "acceptEdits", "destination": "session"}], "toolu_edit")
    tool_result("toolu_edit", "The file has been updated." if allowed(decision) else "The user doesn't want to proceed with this tool use.", not allowed(decision))
    stream_text("Done." if allowed(decision) else "OK, I won't.")
    result("ok")


def remote_turn():
    """Someone types in the Claude app (Remote Control): the CLI echoes the prompt it takes up, and answers it here too."""
    out({"type": "user", "message": {"role": "user", "content": [{"type": "text", "text": "Run the tests from my phone"}]},
         "parent_tool_use_id": None, "session_id": SESSION, "uuid": str(uuid.uuid4()), "isReplay": True})
    # The phone switched to editing on its own.
    out({"type": "system", "subtype": "status", "status": None, "permissionMode": "acceptEdits", "uuid": str(uuid.uuid4()), "session_id": SESSION})
    tool_input = {"command": "dotnet test", "description": "Run the tests"}
    tool_use("toolu_phone", "Bash", tool_input)
    request_id = str(uuid.uuid4())
    out({"type": "control_request", "request_id": request_id, "request": {
        "subtype": "can_use_tool", "tool_name": "Bash", "display_name": "Bash", "input": tool_input, "permission_suggestions": [],
        "tool_use_id": "toolu_phone"}})
    time.sleep(0.3)
    # Allowed on the phone: the question Karvon was asked is withdrawn.
    out({"type": "control_cancel_request", "request_id": request_id})
    tool_result("toolu_phone", "Passed! 12 tests")
    stream_text("All 12 tests passed.")
    result("ok")


def wait_for(name):
    path = os.path.join(CWD, name)
    while not os.path.exists(path):
        time.sleep(0.05)


def system(subtype, **fields):
    out({"type": "system", "subtype": subtype, **fields, "uuid": str(uuid.uuid4()), "session_id": SESSION})


JOB = {"task_id": "bjob1", "task_type": "local_bash", "description": "A long job"}


def finish_job():
    """The longjob's command ends once the test lets it (.fake-claude-job-done): Claude Code says so, then takes up its
    notification in a turn of its own, which ends once the test lets it (.fake-claude-job-go)."""
    wait_for(".fake-claude-job-done")
    system("task_notification", task_id=JOB["task_id"], tool_use_id="toolu_job", status="completed", output_file="", summary=JOB["description"])
    system("background_tasks_changed", tasks=[])
    stream_text("The job finished.")
    wait_for(".fake-claude-job-go")
    result("ok")
    open(os.path.join(CWD, ".fake-claude-job-finished"), "w").close()


def turn(prompt, content, sent=None):
    out({"type": "system", "subtype": "init", "session_id": SESSION, "cwd": CWD, "model": "fake", "permissionMode": "default"})
    if sent is not None and "--replay-user-messages" in ARGS:
        # Claude Code echoes the prompt as it takes it up, with the uuid it was sent with.
        echo = {"type": "user", "message": sent["message"], "parent_tool_use_id": None, "session_id": SESSION, "isReplay": True}
        if sent.get("uuid"):
            echo["uuid"] = sent["uuid"]
        out(echo)
    if isinstance(content, str) and content.startswith("/"):
        command(content)
        return
    p = prompt.lower()
    images = [b for b in content if isinstance(b, dict) and b.get("type") == "image"] if isinstance(content, list) else []
    if images:
        stream_text(f"I see {len(images)} image{'s' if len(images) != 1 else ''} ({images[0]['source']['media_type']}).")
        result("ok")
    elif "endpoint" in p:
        demo()
