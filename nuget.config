<?xml version="1.0" encoding="utf-8"?>
<!-- Karvon's packages all come from nuget.org: a machine's other feeds (a private one that cannot be reached) never hold its restore. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
