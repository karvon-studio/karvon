<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Karvon.ViewModels"
        xmlns:v="using:Karvon.Views"
        x:Class="Karvon.Views.DocumentWindow"
        x:DataType="vm:MainViewModel"
        Width="900" Height="650"
        Icon="/Assets/karvon.png"
        Background="{StaticResource VsEnvironmentBrush}"
        Foreground="{StaticResource VsTextBrush}">
  <Panel>
    <v:DocumentGroupView Name="GroupView" />
    <!-- Where a dragged tab would go -->
    <Canvas Name="DropLayer" IsHitTestVisible="False">
      <Border Name="DropPreview" Classes="droppreview" IsVisible="False" />
    </Canvas>
  </Panel>
</Window>
