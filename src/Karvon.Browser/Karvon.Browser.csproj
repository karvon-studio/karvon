<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Browser module: Karvon's own Chrome (a profile of its own), driven by Claude Code's tools through the DevTools protocol. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Karvon.Browser</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Karvon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Snapshot.js" LogicalName="Karvon.Browser.Snapshot.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karvon.Core\Karvon.Core.csproj" />
  </ItemGroup>
</Project>
