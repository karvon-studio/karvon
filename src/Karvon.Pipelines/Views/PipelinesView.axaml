<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:pvm="using:Karvon.Pipelines.ViewModels"
             x:Class="Karvon.Pipelines.Views.PipelinesView"
             x:DataType="pvm:PipelinesViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon.Core/Themes/ExplorerStyles.axaml" />
    <Style Selector="ListBox#RunList ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Grid.run StackPanel.rowActions">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Grid.run StackPanel.rowActions, ListBoxItem:selected Grid.run StackPanel.rowActions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid.run Button.tbi v|VsIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}">
      <TextBlock Classes="toolTitle" Text="Pipelines" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="4,2">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Name="RefreshButton" Classes="tbi" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh"><v:VsIcon Kind="Refresh" /></Button>
          <ToggleButton Name="AllBranchesButton" Classes="tb" Padding="4,1" IsChecked="{Binding AllBranches}" ToolTip.Tip="Every branch's runs (else the checked-out branch's)">
            <v:VsIcon Kind="Branch" />
          </ToggleButton>
          <Button Classes="tbi" Command="{Binding SignInCommand}" IsVisible="{Binding HasRepository}" ToolTip.Tip="Token…"><v:VsIcon Kind="Plug" /></Button>
        </StackPanel>
        <ComboBox Name="RepositoryBox" ItemsSource="{Binding Repositories}" SelectedItem="{Binding Repository}" IsVisible="{Binding HasManyRepositories}"
                  MinWidth="140" Margin="6,0,0,0" HorizontalAlignment="Right" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="60" Height="3" MinWidth="0" Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Classes="dkMuted" FontSize="11" Margin="10,0,10,4" TextTrimming="CharacterEllipsis"
               IsVisible="{Binding Heading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- No token yet: what Karvon needs, and where to get it -->
    <StackPanel DockPanel.Dock="Top" IsVisible="{Binding NeedsToken}" Margin="12,8" Spacing="8">
      <TextBlock Text="{Binding Repository.ProviderName, FallbackValue=''}" FontWeight="SemiBold" />
      <TextBlock Classes="dkMuted" TextWrapping="Wrap"
                 Text="Karvon reads the runs with your own sign-in: gh auth login for GitHub, a personal access token for a GitLab (kept in the system keyring; Claude Code never sees it)." />
      <Button Name="SignInButton" Classes="dkPrimary" Content="Sign In…" Command="{Binding SignInCommand}" HorizontalAlignment="Left" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Name="Message" Text="{Binding Message}" Classes="dkMuted" TextWrapping="Wrap" Margin="12,8"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <ListBox Name="RunList" ItemsSource="{Binding Runs}" Background="Transparent" DoubleTapped="OnRunDoubleTapped" KeyDown="OnRunKeyDown">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="pvm:PipelineRow">
          <Grid Classes="run" ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Pipeline.Url}">
            <v:VsIcon Kind="{Binding Icon}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,8,0" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Text="{Binding Heading}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Classes="dkMuted" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Panel Grid.Column="2" Margin="8,0,0,0">
              <TextBlock Text="{Binding Duration}" Classes="dkMuted" FontSize="11" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Right" />
              <StackPanel Classes="rowActions" Orientation="Horizontal" Spacing="1" VerticalAlignment="Bottom" Background="{StaticResource VsToolWindowBrush}">
                <Button Classes="tbi" Command="{Binding $parent[UserControl].((pvm:PipelinesViewModel)DataContext).RetryCommand}" CommandParameter="{Binding}"
                        IsVisible="{Binding IsFailed}" ToolTip.Tip="Re-run Failed Jobs"><v:VsIcon Kind="Restart" /></Button>
                <Button Classes="tbi" Command="{Binding $parent[UserControl].((pvm:PipelinesViewModel)DataContext).CancelCommand}" CommandParameter="{Binding}"
                        IsVisible="{Binding IsActive}" ToolTip.Tip="Cancel"><v:VsIcon Kind="Stop" /></Button>
                <Button Classes="tbi" Command="{Binding $parent[UserControl].((pvm:PipelinesViewModel)DataContext).OpenInBrowserCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Open in Browser"><v:VsIcon Kind="Globe" /></Button>
              </StackPanel>
            </Panel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
