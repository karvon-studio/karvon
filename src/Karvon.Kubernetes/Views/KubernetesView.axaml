<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:kvm="using:Karvon.Kubernetes.ViewModels"
             x:Class="Karvon.Kubernetes.Views.KubernetesView"
             x:DataType="kvm:KubernetesViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon.Core/Themes/ExplorerStyles.axaml" />
    <Style Selector="TreeView#Tree TreeViewItem" x:DataType="kvm:KubeGroup">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid.kNode">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="#F14C4C" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}">
      <TextBlock Classes="toolTitle" Text="Kubernetes" />
    </Border>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="4,2">
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Name="RefreshButton" Classes="tbi" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh"><v:VsIcon Kind="Refresh" /></Button>
      </StackPanel>
      <ComboBox Name="ContextBox" Grid.Column="1" ItemsSource="{Binding Contexts}" SelectedItem="{Binding Context}" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                ToolTip.Tip="The kubeconfig context (kubectl's own stays as it is)" />
      <ComboBox Name="NamespaceBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Namespaces}" SelectedItem="{Binding Namespace}" HorizontalAlignment="Stretch"
                Margin="4,3,0,0" IsVisible="{Binding HasContext}" />
    </Grid>
    <Border DockPanel.Dock="Top" Background="#3D1C1E" Padding="10,4" Margin="4,4,4,0" CornerRadius="3" IsVisible="{Binding IsProduction}">
      <TextBlock Text="Production cluster: every change asks first." Foreground="#FF7B72" FontSize="11" />
    </Border>
    <TextBox DockPanel.Dock="Top" Name="FilterBox" Classes="dkField" Text="{Binding Filter}" PlaceholderText="Filter by name" Margin="6,4" IsVisible="{Binding HasContext}" />
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="0" Margin="6,0" />
    <TextBlock DockPanel.Dock="Top" Name="Message" Text="{Binding Message}" Classes="dkMuted" TextWrapping="Wrap" Margin="12,8"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock DockPanel.Dock="Top" Name="Warning" Text="{Binding Warning}" Foreground="#CCA700" FontSize="11" TextWrapping="Wrap" Margin="12,2"
               IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- The port forwards made here -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,1,0,0" Padding="8,6" IsVisible="{Binding HasForwards}">
      <StackPanel Spacing="4">
        <TextBlock Text="Port Forwards" FontWeight="SemiBold" />
        <ItemsControl Name="Forwards" ItemsSource="{Binding Forwards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="kvm:PortForwardRow">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="dkMuted" FontSize="11" TextTrimming="CharacterEllipsis"><Run Text="{Binding Url}" /><Run Text=" · " /><Run Text="{Binding State}" /></TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Classes="tbi" Command="{Binding $parent[UserControl].((kvm:KubernetesViewModel)DataContext).OpenForwardCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Open in Browser"><v:VsIcon Kind="Globe" /></Button>
                <Button Grid.Column="2" Classes="tbi" Command="{Binding $parent[UserControl].((kvm:KubernetesViewModel)DataContext).StopForwardCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Stop"><v:VsIcon Kind="Stop" /></Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TreeView Name="Tree" ItemsSource="{Binding Groups}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              DoubleTapped="OnTreeDoubleTapped" KeyDown="OnTreeKeyDown" IsVisible="{Binding HasContext}">
      <TreeView.DataTemplates>
        <TreeDataTemplate DataType="kvm:KubeGroup" ItemsSource="{Binding Items}">
          <Grid Classes="kNode" ColumnDefinitions="Auto,*,Auto">
            <v:VsIcon Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="6,0">
              <TextBlock Text="{Binding Problems, StringFormat={}{0} failing}" Classes="problem" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding HasProblems}" />
              <TextBlock Text="{Binding Count}" Classes="dkMuted" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </TreeDataTemplate>
        <DataTemplate DataType="kvm:KubeRow">
          <Grid Classes="kNode" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Detail}">
            <StackPanel>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Classes="dkMuted" FontSize="11" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6,0" VerticalAlignment="Top">
              <TextBlock Text="{Binding Status}" Classes.problem="{Binding IsProblem}" Classes.dkMuted="{Binding !IsProblem}" FontSize="11" IsVisible="{Binding HasStatus}" />
              <TextBlock Text="{Binding Ready}" Classes="dkMuted" FontSize="11" />
              <TextBlock Text="{Binding Age}" Classes="dkMuted" FontSize="11" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </TreeView.DataTemplates>
    </TreeView>
  </DockPanel>
</UserControl>
