<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:j="using:Karvon.Jira"
             xmlns:jvm="using:Karvon.Jira.ViewModels"
             xmlns:jv="using:Karvon.Jira.Views"
             x:Class="Karvon.Jira.Views.JiraIssuePageView"
             x:DataType="jvm:JiraIssuePageViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon.Core/Themes/ExplorerStyles.axaml" />
  </UserControl.Styles>

  <DockPanel Background="{StaticResource VsToolWindowBrush}">
    <!-- Its key, summary and status, and what can be done with it -->
    <Border DockPanel.Dock="Top" Padding="20,14,20,10" BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding IssueKey}" Foreground="#4DAAFC" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Issue.Summary.Type, FallbackValue=''}" Classes="dkMuted" VerticalAlignment="Center" />
        </StackPanel>
        <SelectableTextBlock Name="Summary" Text="{Binding Issue.Summary.Summary, FallbackValue=''}" FontSize="20" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal">
          <Border Name="StatusLozenge" CornerRadius="3" Padding="8,3" Margin="0,0,8,6" VerticalAlignment="Center"
                  Background="{Binding Issue.Summary.StatusCategory, FallbackValue='', Converter={x:Static jv:JiraConverters.StatusBrush}}" IsVisible="{Binding HasIssue}">
            <TextBlock Text="{Binding Issue.Summary.Status, FallbackValue=''}" FontWeight="SemiBold" FontSize="12" />
          </Border>
          <Button Name="TransitionButton" Classes="dkPrimary" Content="Move to…" Margin="0,0,6,6" IsEnabled="{Binding HasTransitions}">
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding Transitions}">
                <MenuFlyout.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="j:JiraTransition">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="Command" Value="{Binding $parent[UserControl].((jvm:JiraIssuePageViewModel)DataContext).TransitionCommand}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                  </ControlTheme>
                </MenuFlyout.ItemContainerTheme>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="dkOutline" Content="Assign to me" Command="{Binding AssignToMeCommand}" Margin="0,0,6,6" />
          <Button Classes="dkOutline" Content="Open in Jira" Command="{Binding OpenInBrowserCommand}" Margin="0,0,6,6" />
          <Button Classes="dkOutline" Command="{Binding AskClaudeCommand}" Margin="0,0,6,6" ToolTip.Tip="The issue as Claude Code's task: it reads it with its Jira tools">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:VsIcon Kind="Claude" Width="14" Height="14" />
              <TextBlock Text="Ask Claude" />
            </StackPanel>
          </Button>
          <Button Classes="tbi" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" Margin="0,0,6,6"><v:VsIcon Kind="Refresh" /></Button>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" Height="3" MinWidth="0" VerticalAlignment="Center" Margin="0,0,0,6" />
        </WrapPanel>
        <TextBlock Name="Error" Text="{Binding Error}" Foreground="#F14C4C" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <!-- Its fields, beside its description and comments -->
    <Border DockPanel.Dock="Right" Width="300" BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="1,0,0,0" Padding="16,12">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl Name="Fields" ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="jvm:JiraField">
              <StackPanel Spacing="1" Margin="0,0,0,10">
                <TextBlock Text="{Binding Name}" Classes="dkMuted" FontSize="11" />
                <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,14" Spacing="10">
        <TextBlock Text="Description" FontWeight="SemiBold" />
        <v:MarkdownView Name="Description" Markdown="{Binding Issue.Description, FallbackValue=''}" />
        <TextBlock Text="Comments" FontWeight="SemiBold" Margin="0,12,0,0" />
        <ItemsControl Name="Comments" ItemsSource="{Binding Issue.Comments, FallbackValue={x:Null}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="j:JiraComment">
              <Border Background="#2D2D30" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                  <TextBlock><Run Text="{Binding Author}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Created, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#9D9D9D" /></TextBlock>
                  <v:MarkdownView Markdown="{Binding Body}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Name="NewComment" Classes="dkField" Text="{Binding NewComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" PlaceholderText="Add a comment…" />
        <Button Classes="dkPrimary" Content="Comment" Command="{Binding CommentCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
