<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Arche module: arche-lsp in the editor, a package's arche-driver commands as its tasks, test blocks in Test Explorer. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Karvon.Arche</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Karvon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karvon.Core\Karvon.Core.csproj" />
  </ItemGroup>

  <!-- Arche's TextMate grammar (arche-lang's; see Grammars/SOURCE.txt) and its file icon. -->
  <ItemGroup>
    <EmbeddedResource Include="Grammars\arche.tmLanguage.json" LogicalName="Grammars/arche.tmLanguage.json" />
    <EmbeddedResource Include="Assets\arche.png" LogicalName="Assets/arche.png" />
  </ItemGroup>
</Project>
