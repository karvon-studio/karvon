<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:mvm="using:Karvon.Mcp.ViewModels"
             x:Class="Karvon.Mcp.Views.McpExplorerView"
             x:DataType="mvm:McpExplorerViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon/Docker/Views/DockerStyles.axaml" />
    <Style Selector="TreeView#Tree TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Every row has IsExpanded: expanding a server connects to it. -->
    <Style Selector="TreeView#Tree TreeViewItem">
      <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="Grid.node">
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="#9D9D9D" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="Foreground" Value="#9D9D9D" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}">
      <TextBlock Classes="toolTitle" Text="MCP Servers" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="4,2">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Name="AddMcpServerButton" Classes="tbi" Command="{Binding AddServerCommand}" ToolTip.Tip="Add MCP Server…">
          <v:VsIcon Kind="Plus" />
        </Button>
        <Button Classes="tbi" Command="{Binding RefreshCommand}" ToolTip.Tip="Read the configurations again">
          <v:VsIcon Kind="Refresh" />
        </Button>
        <Button Classes="tbi" Command="{Binding ConnectAllCommand}" ToolTip.Tip="Connect to every server">
          <v:VsIcon Kind="Plug" />
        </Button>
        <Button Classes="tbi" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse All">
          <v:VsIcon Kind="CollapseAll" />
        </Button>
      </StackPanel>
    </Border>
    <TextBox DockPanel.Dock="Top" Classes="search" Margin="4,0,4,4" Text="{Binding Filter}" PlaceholderText="Search MCP Servers" />

    <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding IsEmpty}" Margin="12,10" Spacing="8">
      <TextBlock Text="No MCP servers yet" FontWeight="SemiBold" />
      <TextBlock Classes="dkMuted" TextWrapping="Wrap"
                 Text="The servers of this folder's .mcp.json, of Claude Code, Codex and Gemini CLI show here, with those you add." />
      <Button Classes="dkPrimary" HorizontalAlignment="Left" Command="{Binding AddServerCommand}" Content="Add MCP Server…" />
    </StackPanel>

    <TreeView Name="Tree" ItemsSource="{Binding Roots}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <TreeView.DataTemplates>
        <TreeDataTemplate DataType="mvm:McpGroupNode" ItemsSource="{Binding Items}">
          <Grid Classes="node" ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding ToolTip}">
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open" Command="{Binding OpenCommand}" IsVisible="{Binding IsBuiltIn}" FontWeight="SemiBold" />
                <MenuItem Header="Add MCP Server…" Command="{Binding AddServerCommand}" />
                <MenuItem Header="Copy Path" Click="OnCopy" Tag="{Binding ToolTip}" IsVisible="{Binding !IsBuiltIn}" />
              </ContextMenu>
            </Grid.ContextMenu>
            <Panel Width="15" Height="15">
              <v:VsIcon Kind="Claude" Width="15" Height="15" IsVisible="{Binding IsBuiltIn}" />
              <v:VsIcon Kind="ToolMcp" Width="15" Height="15" Foreground="#4DAAFC" IsVisible="{Binding !IsBuiltIn}" />
            </Panel>
            <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Title}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding CountText}" Foreground="#9D9D9D" />
            </TextBlock>
          </Grid>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="mvm:McpServerNode" ItemsSource="{Binding Children}">
          <Grid Classes="node" ColumnDefinitions="Auto,Auto,*" ToolTip.Tip="{Binding ToolTip}">
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open" Command="{Binding OpenCommand}" FontWeight="SemiBold" />
                <Separator />
                <MenuItem Header="Connect Again" Command="{Binding ConnectAgainCommand}" />
                <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" />
                <MenuItem Header="Sign In…" Command="{Binding SignInCommand}" IsVisible="{Binding CanSignIn}" />
                <MenuItem Header="Sign Out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
                <MenuItem Header="Sign In with Claude Code" Command="{Binding SignInWithClaudeCommand}" IsVisible="{Binding CanSignInWithClaude}" />
                <MenuItem Header="Ask Claude Why" Command="{Binding AskClaudeCommand}" IsVisible="{Binding HasFailed}" />
                <Separator />
                <MenuItem Header="Edit…" Command="{Binding EditCommand}" />
                <MenuItem Header="Remove…" Command="{Binding RemoveCommand}" />
                <MenuItem Header="Copy Command" Click="OnCopy" Tag="{Binding Transport}" />
              </ContextMenu>
            </Grid.ContextMenu>
            <Ellipse Classes="dot" Margin="2,0,8,0" VerticalAlignment="Center"
                     Classes.running="{Binding DotKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=running}"
                     Classes.paused="{Binding DotKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=paused}"
                     Classes.failing="{Binding DotKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=failing}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="detail" Margin="8,0,0,0" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </TreeDataTemplate>

        <DataTemplate DataType="mvm:McpItemNode">
          <Grid Classes="node" ColumnDefinitions="Auto,Auto,*" ToolTip.Tip="{Binding ToolTip}">
            <v:VsIcon Kind="{Binding Icon}" Width="13" Height="13" Margin="0,0,6,0" IsVisible="{Binding !IsStatus}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Classes.status="{Binding IsStatus}" />
            <TextBlock Grid.Column="2" Classes="detail" Margin="8,0,0,0" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>

        <DataTemplate DataType="mvm:McpBuiltInToolNode">
          <Grid Classes="node" ColumnDefinitions="Auto,Auto,*" ToolTip.Tip="{Binding Description}">
            <v:VsIcon Kind="Method" Width="13" Height="13" Margin="0,0,6,0" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="detail" Margin="8,0,0,0" Text="{Binding Access}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>

        <DataTemplate DataType="mvm:McpProblemNode">
          <Grid Classes="node" ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Text}">
            <v:VsIcon Kind="Warning" Width="14" Height="14" Margin="0,0,6,0" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <Run Text="Could not read a configuration" /><Run Text="  " /><Run Text="{Binding Text}" Foreground="#9D9D9D" />
            </TextBlock>
          </Grid>
        </DataTemplate>
      </TreeView.DataTemplates>
    </TreeView>
  </DockPanel>
</UserControl>
