<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:d="using:Karvon.Docker"
             xmlns:dvm="using:Karvon.Docker.ViewModels"
             xmlns:dv="using:Karvon.Docker.Views"
             x:Class="Karvon.Docker.Views.DockerContainersView"
             x:DataType="dvm:ContainersPage">
  <UserControl.Styles>
    <!-- A stack's containers sit under it, indented -->
    <Style Selector="StackPanel.nameCell.child">
      <Setter Property="Margin" Value="30,0,0,0" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="26,20,26,0">
    <StackPanel DockPanel.Dock="Top" Spacing="16">
      <StackPanel>
        <TextBlock Classes="dkTitle" Text="Containers" />
        <TextBlock Classes="dkSubtitle" Text="View all your running containers and applications." />
      </StackPanel>

      <!-- What the running containers use -->
      <Grid ColumnDefinitions="*,14,*" MaxWidth="880" HorizontalAlignment="Left">
        <Border Name="CpuCard" Classes="dkCard">
          <StackPanel Spacing="3">
            <TextBlock Text="Container CPU usage" Classes="dkMuted" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding CpuUsageText}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CpuLimitText}" Classes="dkMuted" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Name="MemoryCard" Grid.Column="2" Classes="dkCard">
          <StackPanel Spacing="3">
            <TextBlock Text="Container memory usage" Classes="dkMuted" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding MemoryUsageText}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding MemoryLimitText}" Classes="dkMuted" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- The open solution's compose file -->
      <Border Name="ComposeBanner" Classes="dkCard" IsVisible="{Binding HasComposeFile}" Padding="14,9" MaxWidth="880" HorizontalAlignment="Left">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <v:VsIcon Kind="DockerStack" Width="20" Height="20" Foreground="#2496ED" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock>
              <Run Text="This solution has " />
              <Run Text="{Binding ComposeFileName}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Text="{Binding ComposeBusyText}" IsVisible="{Binding IsComposeBusy}" Classes="dkMuted" FontSize="11" />
            <!-- What the file gets wrong: a service that reaches another through localhost... -->
            <ItemsControl Name="ComposeProblems" ItemsSource="{Binding ComposeProblems}" IsVisible="{Binding HasComposeProblems}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dvm:ComposeProblem">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                    <v:VsIcon Kind="Warning" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,6,0" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="#E3B341" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
            <Button Name="ComposeUpButton" Classes="dkPrimary" Command="{Binding ComposeUpCommand}" IsEnabled="{Binding !IsComposeBusy}" ToolTip.Tip="docker compose up -d">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <v:VsIcon Kind="DockerPlay" Width="13" Height="13" />
                <TextBlock Text="Compose up" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="dkOutline" Command="{Binding ComposeDownCommand}" IsEnabled="{Binding !IsComposeBusy}" Content="Compose down" ToolTip.Tip="docker compose down" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Search and filter, or what to do with the ticked containers -->
      <Panel Height="34">
        <Grid IsVisible="{Binding !HasSelection}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="300" MinWidth="140" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Panel>
            <TextBox Name="SearchBox" Classes="dkSearch" Text="{Binding Search}" PlaceholderText="Search" />
            <v:VsIcon Kind="Search" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="#9D9D9D" />
          </Panel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="18,0,0,0">
            <ToggleSwitch Name="OnlyRunningSwitch" Classes="dkSwitch" IsChecked="{Binding OnlyRunning}" />
            <TextBlock Text="Only show running containers" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="dkMuted" FontSize="11" Margin="16,0,0,0" />
        </Grid>
        <Border Name="SelectionBar" IsVisible="{Binding HasSelection}" Background="#1F2E4D" CornerRadius="6" Padding="12,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Classes="dkOutline" Command="{Binding StartSelectedCommand}" Content="Start" />
              <Button Classes="dkOutline" Command="{Binding StopSelectedCommand}" Content="Stop" />
              <Button Name="DeleteSelectedButton" Classes="dkOutline" Command="{Binding DeleteSelectedCommand}" Content="Delete" Foreground="#FF7B72" />
            </StackPanel>
            <Button Grid.Column="2" Classes="dkIcon" Width="26" Height="26" Command="{Binding ClearSelectionCommand}" ToolTip.Tip="Clear selection">
              <v:VsIcon Kind="Close" Width="12" Height="12" />
            </Button>
          </Grid>
        </Border>
      </Panel>
    </StackPanel>

    <!-- ===== The table ===== -->
    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
      <Border Classes="dkTableHeader">
        <dv:DockerColumns Layout="40,*160,124?2,180?4,124?5,80?3,124?1,112">
          <CheckBox Classes="dkCheck" IsChecked="{Binding AllSelected}" ToolTip.Tip="Select all" />
          <Button dv:DockerColumns.Column="1" Classes="dkSort" Command="{Binding SortByCommand}" CommandParameter="name">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Name" Classes="dkHeader" />
              <TextBlock Text="{Binding NameSort}" Classes="dkHeader" />
            </StackPanel>
          </Button>
          <TextBlock dv:DockerColumns.Column="2" Text="Container ID" Classes="dkHeader" />
          <Button dv:DockerColumns.Column="3" Classes="dkSort" Command="{Binding SortByCommand}" CommandParameter="image">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Image" Classes="dkHeader" />
              <TextBlock Text="{Binding ImageSort}" Classes="dkHeader" />
            </StackPanel>
          </Button>
          <TextBlock dv:DockerColumns.Column="4" Text="Port(s)" Classes="dkHeader" />
          <Button dv:DockerColumns.Column="5" Classes="dkSort" Command="{Binding SortByCommand}" CommandParameter="cpu">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="CPU (%)" Classes="dkHeader" />
              <TextBlock Text="{Binding CpuSort}" Classes="dkHeader" />
            </StackPanel>
          </Button>
          <Button dv:DockerColumns.Column="6" Classes="dkSort" Command="{Binding SortByCommand}" CommandParameter="started">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Last started" Classes="dkHeader" />
              <TextBlock Text="{Binding StartedSort}" Classes="dkHeader" />
            </StackPanel>
          </Button>
          <TextBlock dv:DockerColumns.Column="7" Text="Actions" Classes="dkHeader" HorizontalAlignment="Right" Margin="0,0,12,0" />
        </dv:DockerColumns>
      </Border>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <ItemsControl Name="Table" ItemsSource="{Binding Rows}">
            <ItemsControl.DataTemplates>
              <!-- A compose stack -->
              <DataTemplate DataType="dvm:StackRow">
                <Border Classes="dkRow" Classes.selected="{Binding IsSelected}" DoubleTapped="OnStackDoubleTapped">
                  <dv:DockerColumns Layout="40,*160,124?2,180?4,124?5,80?3,124?1,112">
                    <CheckBox Classes="dkCheck" IsChecked="{Binding IsSelected}" />
                    <StackPanel dv:DockerColumns.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Classes="dkIcon" Width="22" Height="22" Command="{Binding ToggleCommand}" ToolTip.Tip="Show or hide its containers">
                        <v:VsIcon Kind="Chevron" Width="13" Height="13" Classes.collapsed="{Binding !IsExpanded}">
                          <v:VsIcon.Styles>
                            <Style Selector="v|VsIcon.collapsed">
                              <Setter Property="RenderTransform" Value="rotate(-90deg)" />
                            </Style>
                          </v:VsIcon.Styles>
                        </v:VsIcon>
                      </Button>
                      <v:VsIcon Kind="DockerStack" Width="18" Height="18" Classes="state"
                                Classes.running="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=running}"
                                Classes.paused="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=paused}"
                                Classes.failing="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=failing}" />
                      <StackPanel VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Border Classes="pill blue" IsVisible="{Binding IsThisSolution}">
                            <TextBlock Text="This solution" />
                          </Border>
                          <v:VsIcon Kind="Warning" Width="14" Height="14" IsVisible="{Binding HasProblems}" ToolTip.Tip="{Binding ProblemsText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StateText}" FontSize="11" Classes="dkMuted" IsVisible="{Binding IsIdle}" />
                        <TextBlock Text="{Binding BusyText}" FontSize="11" Foreground="#79A6F6" IsVisible="{Binding IsBusy}" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock dv:DockerColumns.Column="5" Classes="dkCell" Text="{Binding CpuText}" />
                    <TextBlock dv:DockerColumns.Column="6" Classes="dkCell" Text="{Binding LastStartedText}" />
                    <StackPanel dv:DockerColumns.Column="7" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" Margin="0,0,4,0">
                      <Button Classes="dkIcon" Command="{Binding StartStopCommand}" ToolTip.Tip="{Binding StartStopTip}" IsEnabled="{Binding IsIdle}">
                        <Panel>
                          <v:VsIcon Kind="DockerStop" IsVisible="{Binding IsUp}" />
                          <v:VsIcon Kind="DockerPlay" IsVisible="{Binding !IsUp}" />
                        </Panel>
                      </Button>
                      <Button Classes="dkIcon" ToolTip.Tip="More actions" IsEnabled="{Binding IsIdle}">
                        <v:VsIcon Kind="DockerMore" />
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Restart" Command="{Binding RestartCommand}" />
                            <MenuItem Header="Copy project name" Click="OnCopy" Tag="{Binding Name}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button Classes="dkIcon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" IsEnabled="{Binding IsIdle}">
                        <v:VsIcon Kind="DockerDelete" />
                      </Button>
                    </StackPanel>
                  </dv:DockerColumns>
                </Border>
              </DataTemplate>

              <!-- A container -->
              <DataTemplate DataType="dvm:ContainerRow">
                <Border Classes="dkRow" Classes.selected="{Binding IsSelected}" DoubleTapped="OnContainerDoubleTapped">
                  <dv:DockerColumns Layout="40,*160,124?2,180?4,124?5,80?3,124?1,112">
                    <CheckBox Classes="dkCheck" IsChecked="{Binding IsSelected}" />
                    <StackPanel dv:DockerColumns.Column="1" Orientation="Horizontal" Spacing="10" Classes="nameCell" Classes.child="{Binding IsChild}">
                      <v:VsIcon Kind="DockerContainer" Width="18" Height="18" Classes="state"
                                Classes.running="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=running}"
                                Classes.paused="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=paused}"
                                Classes.failing="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=failing}" />
                      <StackPanel VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Classes="dkLink plain" Command="{Binding OpenCommand}" ToolTip.Tip="View details">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <v:VsIcon Kind="Warning" Width="13" Height="13" IsVisible="{Binding HasProblems}" ToolTip.Tip="{Binding ProblemsText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StateText}" FontSize="11" Classes="dkMuted" IsVisible="{Binding IsIdle}" />
                        <TextBlock Text="{Binding BusyText}" FontSize="11" Foreground="#79A6F6" IsVisible="{Binding IsBusy}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel dv:DockerColumns.Column="2" Orientation="Horizontal" Spacing="2">
                      <TextBlock Classes="dkCell dkMono" Text="{Binding ShortId}" />
                      <Button Classes="dkIcon" Width="22" Height="22" Click="OnCopy" Tag="{Binding Container.Id}" ToolTip.Tip="Copy the container ID">
                        <v:VsIcon Kind="Copy" Width="12" Height="12" />
                      </Button>
                    </StackPanel>
                    <Button dv:DockerColumns.Column="3" Classes="dkLink" Command="{Binding OpenImageCommand}" ToolTip.Tip="{Binding Image}" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Image}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <StackPanel dv:DockerColumns.Column="4" Orientation="Horizontal" Spacing="6">
                      <Button Classes="dkLink" IsVisible="{Binding HasPorts}" Command="{Binding OpenPortCommand}" CommandParameter="{Binding FirstPort}" ToolTip.Tip="Open in the browser">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                          <TextBlock Text="{Binding FirstPort.Text, FallbackValue=''}" />
                          <v:VsIcon Kind="DockerLink" Width="11" Height="11" />
                        </StackPanel>
                      </Button>
                      <TextBlock Text="{Binding MorePortsText}" IsVisible="{Binding HasMorePorts}" ToolTip.Tip="{Binding PortsTip}" Classes="dkMuted" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock dv:DockerColumns.Column="5" Classes="dkCell" Text="{Binding CpuText}" />
                    <TextBlock dv:DockerColumns.Column="6" Classes="dkCell" Text="{Binding LastStartedText}" />
                    <StackPanel dv:DockerColumns.Column="7" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" Margin="0,0,4,0">
                      <Button Classes="dkIcon" Command="{Binding StartStopCommand}" ToolTip.Tip="{Binding StartStopTip}" IsEnabled="{Binding IsIdle}">
                        <Panel>
                          <v:VsIcon Kind="DockerStop" IsVisible="{Binding IsUp}" />
                          <v:VsIcon Kind="DockerPlay" IsVisible="{Binding !IsUp}" />
                        </Panel>
                      </Button>
                      <Button Classes="dkIcon" ToolTip.Tip="More actions" IsEnabled="{Binding IsIdle}">
                        <v:VsIcon Kind="DockerMore" />
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="View details" Command="{Binding OpenCommand}" />
                            <MenuItem Header="Restart" Command="{Binding RestartCommand}" IsEnabled="{Binding IsUp}" />
                            <MenuItem Header="Pause" Command="{Binding PauseResumeCommand}" IsVisible="{Binding IsRunning}" />
                            <MenuItem Header="Resume" Command="{Binding PauseResumeCommand}" IsVisible="{Binding IsPaused}" />
                            <MenuItem Header="Open in browser" Command="{Binding OpenPortCommand}" IsVisible="{Binding HasPorts}" />
                            <MenuItem Header="Ask Claude" Command="{Binding AskClaudeCommand}" />
                            <MenuItem Header="Copy container ID" Click="OnCopy" Tag="{Binding Container.Id}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button Classes="dkIcon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" IsEnabled="{Binding IsIdle}">
                        <v:VsIcon Kind="DockerDelete" />
                      </Button>
                    </StackPanel>
                  </dv:DockerColumns>
                </Border>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>

          <!-- Nothing to show -->
          <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Margin="0,56,0,0" Spacing="8">
            <v:VsIcon Kind="DockerContainer" Width="40" Height="40" Foreground="#5A6270" HorizontalAlignment="Center" />
            <TextBlock Text="Your running containers show here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Run an image from Images, or compose up a project." Classes="dkMuted" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel IsVisible="{Binding HasNoMatches}" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="8">
            <TextBlock Text="No containers match" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Button Classes="dkLink" HorizontalAlignment="Center" Command="{Binding ClearSearchCommand}">
              <TextBlock Text="Clear the search" />
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
