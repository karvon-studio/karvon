<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:dvm="using:Karvon.Docker.ViewModels"
             xmlns:dv="using:Karvon.Docker.Views"
             x:Class="Karvon.Docker.Views.DockerDocumentView"
             x:DataType="dvm:DockerDocument"
             Background="#1E1E1E">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon/Docker/Views/DockerStyles.axaml" />
  </UserControl.Styles>

  <Panel>
    <!-- Asking the engine for the first time -->
    <StackPanel IsVisible="{Binding Explorer.IsEngineStarting}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
      <v:VsIcon Kind="Docker" Width="48" Height="48" Foreground="#2496ED" HorizontalAlignment="Center" />
      <TextBlock Text="Connecting to the Docker engine…" Classes="dkMuted" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Not installed, not running, or no access -->
    <Border Name="EngineStopped" IsVisible="{Binding Explorer.IsEngineStopped}" Classes="dkCard" Padding="28,24" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <v:VsIcon Kind="Docker" Width="48" Height="48" Foreground="#5A6270" HorizontalAlignment="Center" />
        <TextBlock Text="The Docker engine is not available" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <SelectableTextBlock Text="{Binding Explorer.EngineMessage}" TextWrapping="Wrap" Classes="dkMuted dkMono" TextAlignment="Center" />
        <TextBlock Text="{Binding Explorer.EngineHint}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding Explorer.EngineHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Classes="dkPrimary" HorizontalAlignment="Center" Command="{Binding Explorer.RetryCommand}" Content="Retry" />
      </StackPanel>
    </Border>

    <!-- A section's table, or a container's, image's, volume's or network's page -->
    <ContentControl Name="Page" Content="{Binding Content}" IsVisible="{Binding Explorer.IsEngineRunning}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="dvm:ContainersPage">
          <dv:DockerContainersView />
        </DataTemplate>
        <DataTemplate DataType="dvm:ImagesPage">
          <dv:DockerImagesView />
        </DataTemplate>
        <DataTemplate DataType="dvm:VolumesPage">
          <dv:DockerVolumesView />
        </DataTemplate>
        <DataTemplate DataType="dvm:NetworksPage">
          <dv:DockerNetworksView />
        </DataTemplate>
        <DataTemplate DataType="dvm:ContainerDetailViewModel">
          <dv:DockerContainerView />
        </DataTemplate>
        <DataTemplate DataType="dvm:ImageDetailViewModel">
          <dv:DockerImageView />
        </DataTemplate>
        <DataTemplate DataType="dvm:VolumeDetailViewModel">
          <dv:DockerVolumeView />
        </DataTemplate>
        <DataTemplate DataType="dvm:NetworkDetailViewModel">
          <dv:DockerNetworkView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Panel>
</UserControl>
