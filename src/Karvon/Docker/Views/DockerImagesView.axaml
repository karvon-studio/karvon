<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:dvm="using:Karvon.Docker.ViewModels"
             xmlns:dv="using:Karvon.Docker.Views"
             x:Class="Karvon.Docker.Views.DockerImagesView"
             x:DataType="dvm:ImagesPage">
  <DockPanel Margin="26,20,26,0">
    <StackPanel DockPanel.Dock="Top" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="dkTitle" Text="Images" />
          <TextBlock Classes="dkSubtitle" Text="Images you pulled or built: run one as a container, or clean up what nothing uses." />
        </StackPanel>
        <!-- Pull an image by name -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBox Name="PullBox" Classes="dkField" Width="240" Text="{Binding PullReference}" PlaceholderText="Image to pull, e.g. nginx:latest" KeyDown="OnPullKeyDown" />
          <Button Name="PullButton" Classes="dkPrimary" Command="{Binding PullCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:VsIcon Kind="Pull" Width="13" Height="13" />
              <TextBlock Text="Pull" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,14,*" MaxWidth="880" HorizontalAlignment="Left">
        <Border Classes="dkCard">
          <StackPanel Spacing="3">
            <TextBlock Text="Local images" Classes="dkMuted" FontSize="12" />
            <TextBlock Text="{Binding TotalText}" FontSize="18" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="dkCard">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" Margin="0,0,20,0">
              <TextBlock Text="Unused" Classes="dkMuted" FontSize="12" />
              <TextBlock Text="{Binding UnusedText}" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
            <Button Name="CleanUpButton" Grid.Column="1" Classes="dkOutline" Command="{Binding CleanUpCommand}" Content="Clean up" VerticalAlignment="Center"
                    ToolTip.Tip="Delete every image no container uses" IsEnabled="{Binding HasUnused}" />
          </Grid>
        </Border>
      </Grid>

      <!-- A pull in progress -->
      <Border IsVisible="{Binding IsPulling}" Background="#1C2E50" CornerRadius="6" Padding="12,7" MaxWidth="880" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" />
          <TextBlock Text="{Binding PullStatus}" TextTrimming="CharacterEllipsis" MaxWidth="700" />
        </StackPanel>
      </Border>

      <Panel Height="34">
        <Grid IsVisible="{Binding !HasSelection}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="300" MinWidth="140" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Panel>
            <TextBox Name="SearchBox" Classes="dkSearch" Text="{Binding Search}" PlaceholderText="Search" />
            <v:VsIcon Kind="Search" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="#9D9D9D" />
          </Panel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="18,0,0,0">
            <ToggleSwitch Classes="dkSwitch" IsChecked="{Binding OnlyUnused}" />
            <TextBlock Text="Only show unused images" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Border IsVisible="{Binding HasSelection}" Background="#1F2E4D" CornerRadius="6" Padding="12,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Classes="dkOutline" Command="{Binding DeleteSelectedCommand}" Content="Delete" Foreground="#FF7B72" />
            </StackPanel>
            <Button Grid.Column="2" Classes="dkIcon" Width="26" Height="26" Command="{Binding ClearSelectionCommand}" ToolTip.Tip="Clear selection">
              <v:VsIcon Kind="Close" Width="12" Height="12" />
            </Button>
          </Grid>
        </Border>
      </Panel>
    </StackPanel>

    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
      <Border Classes="dkTableHeader">
        <dv:DockerColumns Layout="40,*180,140?3,124?1,100?4,120?2,100,112">
          <CheckBox Classes="dkCheck" IsChecked="{Binding AllSelected}" ToolTip.Tip="Select all" />
          <Button dv:DockerColumns.Column="1" Classes="dkSort" Command="{Binding SortByCommand}" CommandParameter="name">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Name" Classes="dkHeader" />
              <TextBlock Text="{Binding NameSort}" Classes="dkHeader" />
            </StackPanel>
          </Button>
          <TextBlock dv:DockerColumns.Column="2" Text="Tag" Classes="dkHeader" />
          <TextBlock dv:DockerColumns.Column="3" Text="Image ID" Classes="dkHeader" />
          <TextBlock dv:DockerColumns.Column="4" Text="Status" Classes="dkHeader" />
          <Button dv:DockerColumns.Column="5" Classes="dkSort" Command="{Binding SortByCommand}" CommandParameter="created">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Created" Classes="dkHeader" />
              <TextBlock Text="{Binding CreatedSort}" Classes="dkHeader" />
            </StackPanel>
          </Button>
          <Button dv:DockerColumns.Column="6" Classes="dkSort" Command="{Binding SortByCommand}" CommandParameter="size">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Size" Classes="dkHeader" />
              <TextBlock Text="{Binding SizeSort}" Classes="dkHeader" />
            </StackPanel>
          </Button>
          <TextBlock dv:DockerColumns.Column="7" Text="Actions" Classes="dkHeader" HorizontalAlignment="Right" Margin="0,0,12,0" />
        </dv:DockerColumns>
      </Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <ItemsControl Name="Table" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dvm:ImageRow">
                <Border Classes="dkRow" Classes.selected="{Binding IsSelected}" DoubleTapped="OnRowDoubleTapped">
                  <dv:DockerColumns Layout="40,*180,140?3,124?1,100?4,120?2,100,112">
                    <CheckBox Classes="dkCheck" IsChecked="{Binding IsSelected}" />
                    <StackPanel dv:DockerColumns.Column="1" Orientation="Horizontal" Spacing="10">
                      <v:VsIcon Kind="DockerImage" Width="18" Height="18" Classes="state" Classes.running="{Binding InUse}" />
                      <StackPanel VerticalAlignment="Center">
                        <Button Classes="dkLink plain" Command="{Binding OpenCommand}" ToolTip.Tip="View details">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <TextBlock Text="{Binding BusyText}" FontSize="11" Foreground="#79A6F6" IsVisible="{Binding IsBusy}" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock dv:DockerColumns.Column="2" Classes="dkCell" Text="{Binding Tag}" Margin="0,0,8,0" />
                    <StackPanel dv:DockerColumns.Column="3" Orientation="Horizontal" Spacing="2">
                      <TextBlock Classes="dkCell dkMono" Text="{Binding ShortId}" />
                      <Button Classes="dkIcon" Width="22" Height="22" Click="OnCopy" Tag="{Binding Image.Id}" ToolTip.Tip="Copy the image ID">
                        <v:VsIcon Kind="Copy" Width="12" Height="12" />
                      </Button>
                    </StackPanel>
                    <Border dv:DockerColumns.Column="4" Classes="pill" Classes.green="{Binding InUse}">
                      <TextBlock Text="{Binding StatusText}" />
                    </Border>
                    <TextBlock dv:DockerColumns.Column="5" Classes="dkCell" Text="{Binding CreatedText}" />
                    <TextBlock dv:DockerColumns.Column="6" Classes="dkCell" Text="{Binding SizeText}" />
                    <StackPanel dv:DockerColumns.Column="7" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" Margin="0,0,4,0">
                      <Button Classes="dkIcon" Command="{Binding RunCommand}" ToolTip.Tip="Run" IsEnabled="{Binding !IsBusy}">
                        <v:VsIcon Kind="DockerPlay" />
                      </Button>
                      <Button Classes="dkIcon" ToolTip.Tip="More actions">
                        <v:VsIcon Kind="DockerMore" />
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="View details" Command="{Binding OpenCommand}" />
                            <MenuItem Header="Copy image ID" Click="OnCopy" Tag="{Binding Image.Id}" />
                            <MenuItem Header="Copy name" Click="OnCopy" Tag="{Binding Image.Reference}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button Classes="dkIcon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" IsEnabled="{Binding !IsBusy}">
                        <v:VsIcon Kind="DockerDelete" />
                      </Button>
                    </StackPanel>
                  </dv:DockerColumns>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Margin="0,56,0,0" Spacing="8">
            <v:VsIcon Kind="DockerImage" Width="40" Height="40" Foreground="#5A6270" HorizontalAlignment="Center" />
            <TextBlock Text="No images yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Pull one by its name above, or build one from a Dockerfile." Classes="dkMuted" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel IsVisible="{Binding HasNoMatches}" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="8">
            <TextBlock Text="No images match" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Button Classes="dkLink" HorizontalAlignment="Center" Command="{Binding ClearSearchCommand}">
              <TextBlock Text="Clear the search" />
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
