<Project Sdk="Microsoft.NET.Sdk">
  <!-- Karvon Studio, the application: the core and the modules it comes with. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Karvon</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Karvon.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Karvon.Core\Karvon.Core.csproj" />
    <ProjectReference Include="..\Karvon.Database\Karvon.Database.csproj" />
    <ProjectReference Include="..\Karvon.Docker\Karvon.Docker.csproj" />
    <ProjectReference Include="..\Karvon.Servers\Karvon.Servers.csproj" />
    <ProjectReference Include="..\Karvon.Jira\Karvon.Jira.csproj" />
    <ProjectReference Include="..\Karvon.Ports\Karvon.Ports.csproj" />
    <ProjectReference Include="..\Karvon.Pipelines\Karvon.Pipelines.csproj" />
    <ProjectReference Include="..\Karvon.Mcp\Karvon.Mcp.csproj" />
    <ProjectReference Include="..\Karvon.Skills\Karvon.Skills.csproj" />
    <ProjectReference Include="..\Karvon.DotNet\Karvon.DotNet.csproj" />
    <ProjectReference Include="..\Karvon.TypeScript\Karvon.TypeScript.csproj" />
    <ProjectReference Include="..\Karvon.Python\Karvon.Python.csproj" />
    <ProjectReference Include="..\Karvon.Go\Karvon.Go.csproj" />
    <ProjectReference Include="..\Karvon.Rust\Karvon.Rust.csproj" />
    <ProjectReference Include="..\Karvon.Cpp\Karvon.Cpp.csproj" />
    <ProjectReference Include="..\Karvon.Java\Karvon.Java.csproj" />
    <ProjectReference Include="..\Karvon.Kotlin\Karvon.Kotlin.csproj" />
    <ProjectReference Include="..\Karvon.Claude\Karvon.Claude.csproj" />
  </ItemGroup>
</Project>
