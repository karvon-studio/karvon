<Project Sdk="Microsoft.NET.Sdk">
  <!-- Karvon Studio, the application: the core and the modules it comes with. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Karvon</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- An IDE's oldest objects come and go (answers, query results, logs): without this the GC keeps their free
         space, which was more than half of a day's heap; with it, it compacts the heap when that much is free. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Karvon.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Karvon.Core\Karvon.Core.csproj" />
    <ProjectReference Include="..\Karvon.Database\Karvon.Database.csproj" />
    <ProjectReference Include="..\Karvon.Docker\Karvon.Docker.csproj" />
    <ProjectReference Include="..\Karvon.Servers\Karvon.Servers.csproj" />
    <ProjectReference Include="..\Karvon.Mcp\Karvon.Mcp.csproj" />
    <ProjectReference Include="..\Karvon.Skills\Karvon.Skills.csproj" />
    <ProjectReference Include="..\Karvon.Claude\Karvon.Claude.csproj" />
  </ItemGroup>
</Project>
