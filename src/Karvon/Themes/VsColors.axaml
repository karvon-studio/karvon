<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="using:Karvon.Views">
  <!-- Visual Studio "Dark" environment palette -->
  <Color x:Key="SystemAccentColor">#007ACC</Color>
  <Color x:Key="SystemAccentColorDark1">#0E639C</Color>
  <Color x:Key="SystemAccentColorLight1">#1C97EA</Color>

  <SolidColorBrush x:Key="VsEnvironmentBrush" Color="#2D2D30" />
  <SolidColorBrush x:Key="VsToolWindowBrush" Color="#252526" />
  <SolidColorBrush x:Key="VsEditorBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="VsBorderBrush" Color="#3F3F46" />
  <SolidColorBrush x:Key="VsMenuBrush" Color="#1B1B1C" />
  <SolidColorBrush x:Key="VsTextBrush" Color="#F1F1F1" />
  <SolidColorBrush x:Key="VsGrayTextBrush" Color="#999999" />
  <SolidColorBrush x:Key="VsAccentBrush" Color="#007ACC" />
  <SolidColorBrush x:Key="VsAccentHoverBrush" Color="#1C97EA" />
  <SolidColorBrush x:Key="VsTabInactiveBrush" Color="#3F3F46" />
  <SolidColorBrush x:Key="VsHoverBrush" Color="#3E3E40" />
  <SolidColorBrush x:Key="VsSelectionBrush" Color="#094771" />
  <SolidColorBrush x:Key="VsStatusReadyBrush" Color="#007ACC" />
  <SolidColorBrush x:Key="VsStatusBusyBrush" Color="#CA5100" />
  <SolidColorBrush x:Key="VsStatusEmptyBrush" Color="#68217A" />
  <SolidColorBrush x:Key="VsErrorBrush" Color="#F14C4C" />
  <SolidColorBrush x:Key="VsWarningBrush" Color="#CCA700" />
  <SolidColorBrush x:Key="VsInfoBrush" Color="#3794FF" />

  <FontFamily x:Key="VsUiFont">Inter, Ubuntu, Noto Sans, sans-serif</FontFamily>
  <FontFamily x:Key="VsCodeFont">avares://Karvon/Assets/Fonts#Cascadia Mono, DejaVu Sans Mono, Noto Sans Mono, monospace</FontFamily>

  <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
  <x:Double x:Key="TreeViewItemMinHeight">20</x:Double>
  <x:Double x:Key="ListBoxItemMinHeight">20</x:Double>

  <!-- Document well tab: blue when active, like VS -->
  <ControlTheme x:Key="VsDocumentTab" TargetType="TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#F1F1F1" />
    <Setter Property="Padding" Value="8,3,2,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,1,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="#1C97EA" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="#007ACC" />
    </Style>
  </ControlTheme>

  <!-- Tool window tab (Error List / Output) at the bottom of a tool window -->
  <ControlTheme x:Key="VsToolTab" TargetType="TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#D0D0D0" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="#55AAFF" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="#252526" />
      <Setter Property="Foreground" Value="#3399FF" />
    </Style>
  </ControlTheme>

  <!-- A tool window in a side group, as an icon of VS Code's activity bar: its name in the tooltip, a count badge,
       a bar at the outer edge for the one in front (the "right" class puts it on the right). -->
  <ControlTheme x:Key="VsActivityTab" TargetType="TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#8A8A8A" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_LayoutRoot" Width="44" Height="44" Background="{TemplateBinding Background}" ToolTip.Tip="{TemplateBinding Header}">
          <Border Name="PART_Indicator" Width="2" HorizontalAlignment="Left" Background="Transparent" />
          <v:VsIcon Kind="{TemplateBinding Tag, Converter={x:Static v:ToolWindowTabs.Icon}}" Width="22" Height="22" Foreground="{TemplateBinding Foreground}" />
          <Border Name="PART_Badge" IsVisible="{TemplateBinding v:ToolWindowTabs.Badge, Converter={x:Static v:ToolWindowTabs.HasBadge}}"
                  Background="#0078D4" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6">
            <TextBlock Text="{TemplateBinding v:ToolWindowTabs.Badge, Converter={x:Static v:ToolWindowTabs.BadgeText}}" FontSize="10" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="#E0E0E0" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="#3399FF" />
    </Style>
    <Style Selector="^.right /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
