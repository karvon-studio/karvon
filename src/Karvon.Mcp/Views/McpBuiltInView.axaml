<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:mvm="using:Karvon.Mcp.ViewModels"
             x:Class="Karvon.Mcp.Views.McpBuiltInView"
             x:DataType="mvm:McpBuiltInDocument"
             Background="#1E1E1E">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon.Core/Themes/ExplorerStyles.axaml" />
  </UserControl.Styles>

  <!-- Karvon's own tools, as the Claude Code sessions Karvon starts have them (mcp__karvon__…) -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,14,20,14" Spacing="6" MaxWidth="900" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <v:VsIcon Kind="Claude" Width="22" Height="22" />
        <TextBlock Text="karvon" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Classes="pill blue">
          <TextBlock Text="built in" />
        </Border>
      </StackPanel>
      <TextBlock Classes="dkMuted" TextWrapping="Wrap" Margin="0,0,0,10"
                 Text="The tools Karvon gives the Claude Code sessions it starts, beside the user's own servers: they work with what Karvon has open (the solution, the debugger, the Database Explorer's data sources, Docker, the Servers) as you would, and hide secrets. Those that only read go at once; a change asks first, and a destructive one asks every time." />
      <TextBlock Classes="dkMuted" IsVisible="{Binding IsOff}" TextWrapping="Wrap"
                 Text="They are off: the ClaudeKarvonTools setting in Karvon's settings.json." />
      <CheckBox Name="ToolsFirst" IsChecked="{Binding ToolsFirst}" IsVisible="{Binding !IsOff}" Margin="0,0,0,10">
        <StackPanel Spacing="2">
          <TextBlock Text="Before the shell" />
          <TextBlock Classes="dkMuted" FontSize="12" TextWrapping="Wrap"
                     Text="Claude is told to use these, and a Bash command one of them does (dotnet build, psql, docker ps, ssh to one of the Servers, curl to Jira) is sent to it; the same command again goes through. For the sessions started after." />
        </StackPanel>
      </CheckBox>
      <CheckBox Name="KeepSecretsAway" IsChecked="{Binding KeepSecretsAway}" Margin="0,0,0,10">
        <StackPanel Spacing="2">
          <TextBlock Text="Keep the secrets away" />
          <TextBlock Classes="dkMuted" FontSize="12" TextWrapping="Wrap"
                     Text="Claude Code's own tools do not read or change a file that holds secrets (.env, keys, certificates, credentials, the SSH keys, the kubeconfig, Karvon's vault), and a shell command that reads one or asks a secret store does not run. For the sessions started after." />
        </StackPanel>
      </CheckBox>
      <CheckBox Name="Sandbox" IsChecked="{Binding Sandbox}" Margin="0,0,0,4">
        <StackPanel Spacing="2">
          <TextBlock Text="Run Claude's shell in a sandbox" />
          <TextBlock Classes="dkMuted" FontSize="12" TextWrapping="Wrap"
                     Text="Claude Code's own sandbox (bubblewrap on Linux, Seatbelt on macOS): what holds secrets cannot be read, no command runs outside it, the package registries and code hosts are reached without a prompt. On Linux no Unix socket is reached from it: not the keyring, not ssh-agent, so a push over SSH is done from Git Changes. For the sessions started after." />
        </StackPanel>
      </CheckBox>
      <TextBlock Classes="dkMuted" Foreground="#F48771" TextWrapping="Wrap" Margin="28,0,0,10" FontSize="12"
                 Text="{Binding SandboxProblem}" IsVisible="{Binding SandboxProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="dkMuted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Each tool's rule is Karvon's, whatever Claude Code's permission mode (Bypass permissions too): Allow runs it at once, Ask asks every time, Deny refuses it. A destructive call asks every time whatever the rule. A rule for one target (db_query@shop, server_exec@prod-1, k8s_scale@prod) goes in ClaudeToolRules in Karvon's settings.json." />
      <ItemsControl ItemsSource="{Binding Tools}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="mvm:McpBuiltInToolNode">
            <Border Classes="dkRow" Padding="12,8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock>
                    <Run Text="{Binding Name}" FontFamily="{StaticResource VsCodeFont}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Access}" Foreground="#9D9D9D" FontSize="11.5" />
                  </TextBlock>
                  <TextBlock Text="{Binding Description}" Classes="dkMuted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" Name="Rule" ItemsSource="{x:Static mvm:McpBuiltInToolNode.Rules}" SelectedItem="{Binding Rule}"
                          MinWidth="150" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip.Tip="This tool's rule" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
