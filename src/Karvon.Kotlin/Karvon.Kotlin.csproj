<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Kotlin module: JetBrains' Kotlin language server in the editor (its Gradle and Maven import), its debugger for F5. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Karvon.Kotlin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Karvon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Karvon.Core\Karvon.Core.csproj" />
  </ItemGroup>

  <!-- Gradle's wrapper (Apache-2.0), as Gradle 9.1.0 makes it: the new project's gradlew, which kotlin-lsp runs it with. -->
  <ItemGroup>
    <EmbeddedResource Include="GradleWrapper\*" LogicalName="GradleWrapper/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Kotlin's TextMate grammar (MIT, vscode-kotlin's; see Grammars/SOURCE.txt): what the editor colors before the server. -->
  <ItemGroup>
    <EmbeddedResource Include="Grammars\kotlin.tmLanguage.json" LogicalName="Grammars/kotlin.tmLanguage.json" />
  </ItemGroup>
</Project>
