<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
             xmlns:http="using:Karvon.Http"
             xmlns:hvm="using:Karvon.Http.ViewModels"
             x:Class="Karvon.Http.Views.HttpPaneView"
             x:DataType="hvm:HttpPaneViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon.Core/Themes/ExplorerStyles.axaml" />
  </UserControl.Styles>

  <DockPanel Background="{StaticResource VsToolWindowBrush}">
    <!-- The environment, and the request at the caret sent -->
    <Border DockPanel.Dock="Top" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="6,3">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Name="SendButton" Classes="dkPrimary" Padding="10,2" Command="{Binding SendCurrentCommand}" ToolTip.Tip="Send the request at the caret">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <v:VsIcon Kind="Send" Width="12" Height="12" />
              <TextBlock Text="Send Request" />
            </StackPanel>
          </Button>
          <Button Classes="tbi" Command="{Binding CancelCommand}" IsVisible="{Binding IsSending}" ToolTip.Tip="Cancel"><v:VsIcon Kind="Stop" /></Button>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSending}" Width="50" Height="3" MinWidth="0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <ComboBox Name="EnvironmentBox" ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}" MinWidth="140"
                    ToolTip.Tip="http-client.env.json's environment" />
          <Button Classes="tbi" Command="{Binding LoadEnvironmentsCommand}" CommandParameter="{x:Null}" ToolTip.Tip="Read the environments again"><v:VsIcon Kind="Refresh" /></Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" Classes="dkMuted" TextWrapping="Wrap" Margin="12,10"
               IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- What came back -->
    <Border DockPanel.Dock="Top" Padding="12,8,12,0" IsVisible="{Binding HasExchange}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="pill" Classes.green="{Binding IsSuccess}" Classes.red="{Binding IsFailure}">
            <TextBlock Name="Status" Text="{Binding StatusText}" />
          </Border>
          <TextBlock Name="Summary" Text="{Binding Summary}" Classes="dkMuted" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Classes="dkTab" Classes.selected="{Binding IsBody}" Command="{Binding ShowTabCommand}" CommandParameter="body" Content="Body" />
          <Button Classes="dkTab" Classes.selected="{Binding IsHeaders}" Command="{Binding ShowTabCommand}" CommandParameter="headers" Content="Headers" />
          <Button Classes="dkTab" Classes.selected="{Binding IsRequest}" Command="{Binding ShowTabCommand}" CommandParameter="request" Content="Request" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- This session's responses of the file -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" MaxHeight="150" IsVisible="{Binding HasExchange}">
      <ListBox Name="History" ItemsSource="{Binding History}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="http:HttpExchange">
            <Button Classes="dkLink" Command="{Binding $parent[UserControl].((hvm:HttpPaneViewModel)DataContext).ShowFromHistoryCommand}" CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <TextBlock TextTrimming="CharacterEllipsis" FontSize="11"><Run Text="{Binding At, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#9D9D9D" /><Run Text="  " /><Run Text="{Binding Method}" /><Run Text=" " /><Run Text="{Binding Url}" /><Run Text="  " /><Run Text="{Binding StatusText}" Foreground="#9D9D9D" /></TextBlock>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Panel Margin="8,6" IsVisible="{Binding HasExchange}">
      <ae:TextEditor Name="BodyEditor" IsVisible="{Binding IsBody}" FontFamily="{StaticResource VsCodeFont}" FontSize="12" Background="#1E1E1E" Foreground="#DCDCDC"
                     ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" WordWrap="True" />
      <ae:TextEditor Name="HeadersEditor" IsVisible="{Binding IsHeaders}" FontFamily="{StaticResource VsCodeFont}" FontSize="12" Background="#1E1E1E" Foreground="#DCDCDC"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
      <ae:TextEditor Name="RequestEditor" IsVisible="{Binding IsRequest}" FontFamily="{StaticResource VsCodeFont}" FontSize="12" Background="#1E1E1E" Foreground="#DCDCDC"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" WordWrap="True" />
    </Panel>
  </DockPanel>
</UserControl>
