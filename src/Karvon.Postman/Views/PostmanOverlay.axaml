<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Karvon.Ui"
             xmlns:pvm="using:Karvon.Postman.ViewModels"
             x:Class="Karvon.Postman.Views.PostmanOverlay"
             x:DataType="pvm:PostmanExplorerViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon.Core/Themes/ExplorerStyles.axaml" />
  </UserControl.Styles>

  <!-- Over the window: the Postman explorer's dialogs. Clicks pass through otherwise. -->
  <Panel Name="DialogLayer" IsVisible="{Binding HasDialog}" Background="#99000000">
    <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="ui:InputDialog" x:DataType="ui:InputDialog">
          <Border Classes="dkCard" Width="440" Padding="22,18" Background="#2B2B2F">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Label}" Classes="dkMuted" />
              <TextBox Name="NameBox" Classes="dkField" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                <Button Classes="dkPrimary" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" IsDefault="True" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
        <DataTemplate DataType="ui:ConfirmDialog" x:DataType="ui:ConfirmDialog">
          <Border Classes="dkCard" Width="460" Padding="22,18" Background="#2B2B2F">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="dkMuted" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                <Button Classes="dkDanger" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Panel>
</UserControl>
