<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:hvm="using:Karvon.Http.ViewModels"
             xmlns:p="using:Karvon.Postman"
             xmlns:pvm="using:Karvon.Postman.ViewModels"
             x:Class="Karvon.Postman.Views.PostmanRunView"
             x:DataType="pvm:PostmanRunDocument"
             Background="#1E1E1E">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon.Core/Themes/ExplorerStyles.axaml" />
  </UserControl.Styles>

  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CountText}" Classes="dkMuted" VerticalAlignment="Center" />
        <v:VsIcon Kind="Globe" Width="13" Height="13" />
        <TextBlock Text="{Binding EnvironmentText}" Classes="dkMuted" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Iterations" Classes="dkMuted" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Iterations}" Minimum="1" Maximum="1000" FormatString="0" Width="110" />
        <TextBlock Text="Delay (ms)" Classes="dkMuted" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Delay}" Minimum="0" Maximum="600000" Increment="100" FormatString="0" Width="120" />
        <CheckBox Content="Stop at a failure" IsChecked="{Binding StopOnFailure}" />
        <Button Name="DataButton" Classes="dkOutline" Command="{Binding ChooseDataCommand}" Content="Data File…" ToolTip.Tip="A CSV or JSON file: an iteration is sent with each of its rows ({{name}}, pm.iterationData)" />
        <TextBlock Text="{Binding DataText}" Classes="dkMuted" VerticalAlignment="Center" />
        <Button Classes="tbi" Command="{Binding ForgetDataCommand}" IsVisible="{Binding HasData}" ToolTip.Tip="Without a data file"><v:VsIcon Kind="Close" Width="11" Height="11" /></Button>
        <Button Name="RunButton" Classes="dkPrimary" Command="{Binding RunCommand}" IsVisible="{Binding !IsRunning}" Content="Run" />
        <Button Classes="dkOutline" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" Content="Stop" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" Width="60" Height="3" MinWidth="0" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Name="Summary" Text="{Binding Summary}" Classes="dkMuted" />
    </StackPanel>

    <Grid RowDefinitions="*,4,*">
      <ListBox Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent" DoubleTapped="OnResultDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="p:PostmanResult">
            <Grid ColumnDefinitions="Auto,56,*,Auto,Auto,Auto" ToolTip.Tip="{Binding Exchange.Url}">
              <v:VsIcon Kind="{Binding Converter={x:Static pvm:PostmanConverters.ResultIcon}}" Width="14" Height="14" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding Exchange.Method}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{Binding Exchange.Method, Converter={x:Static hvm:HttpConverters.MethodBrush}}" />
              <TextBlock Grid.Column="2" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="5" Text="{Binding Row, StringFormat='row {0}'}" Classes="dkMuted" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding Row}" />
              <TextBlock Grid.Column="3" Text="{Binding TestsText}" Classes="dkMuted" FontSize="12" VerticalAlignment="Center" Margin="12,0" />
              <TextBlock Grid.Column="4" Text="{Binding Exchange.Summary}" Classes="dkMuted" FontSize="12" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="#2D2D30" />
      <Panel Grid.Row="2">
        <TextBlock Text="Choose a request to see its tests and what came back; a double click opens it." Classes="dkMuted" Margin="0,8" IsVisible="{Binding !HasSelected}" />
        <TextBox Text="{Binding SelectedText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="{StaticResource VsCodeFont}" FontSize="12" BorderThickness="0"
                 Background="Transparent" VerticalContentAlignment="Top" IsVisible="{Binding HasSelected}" />
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
