<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:VSL.Views"
             xmlns:m="using:VSL.Mcp"
             xmlns:mvm="using:VSL.Mcp.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="VSL.Mcp.Views.McpServerPageView"
             x:DataType="mvm:McpServerPageViewModel"
             Background="#1E1E1E">
  <UserControl.Styles>
    <StyleInclude Source="avares://VSL/Docker/Views/DockerStyles.axaml" />
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#9D9D9D" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="TextBlock.itemName">
      <Setter Property="FontFamily" Value="{StaticResource VsCodeFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.items">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#3F3F46" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="ListBox.items ListBoxItem">
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <!-- What a call gave: read-only, monospaced, red-edged when it is an error. -->
    <Style Selector="TextBox.reply">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontFamily" Value="{StaticResource VsCodeFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="80" />
      <Setter Property="MaxHeight" Value="520" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="Background" Value="#181818" />
      <Setter Property="BorderBrush" Value="#3F3F46" />
    </Style>
    <Style Selector="TextBox.reply.error">
      <Setter Property="BorderBrush" Value="#7A2E32" />
      <Setter Property="Foreground" Value="#FFB4AE" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- One argument: its name (a red * when required), its type, what it is, and where to give it. -->
    <DataTemplate DataType="m:McpField">
      <StackPanel Spacing="3" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text=" *" Foreground="#FF7B72" FontWeight="SemiBold" IsVisible="{Binding IsRequired}" />
          <TextBlock Text="{Binding Type}" Margin="8,0,0,0" FontFamily="{StaticResource VsCodeFont}" FontSize="11" Foreground="#9D9D9D" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding Description}" Classes="dkMuted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
        <TextBox Name="ArgumentText" Classes="dkField" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" IsVisible="{Binding IsText}" />
        <TextBox Classes="dkField" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" IsVisible="{Binding IsJson}" AcceptsReturn="True"
                 FontFamily="{StaticResource VsCodeFont}" FontSize="12" MinHeight="64" TextWrapping="Wrap" VerticalContentAlignment="Top" />
        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" IsVisible="{Binding IsChoice}" MinWidth="200" />
        <CheckBox IsChecked="{Binding Flag}" IsThreeState="{Binding !IsRequired}" Content="{Binding FlagText}" IsVisible="{Binding IsFlag}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel Margin="20,14,20,0">
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <!-- The server, whether VSL is connected to it, and what to do -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <v:VsIcon Kind="ToolMcp" Width="22" Height="22" Foreground="#4DAAFC" />
            <TextBlock Name="McpServerName" Text="{Binding Node.Name}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="pill" Classes.green="{Binding Node.IsConnected}" Classes.red="{Binding Node.HasFailed}">
              <TextBlock Name="McpStatusText" Text="{Binding Node.StatusText}" MaxWidth="520" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Node.StatusText}" />
            </Border>
          </StackPanel>
          <TextBlock Margin="32,0,0,0" Classes="dkMuted dkMono" Text="{Binding TransportLine}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TransportLine}" />
          <TextBlock Margin="32,0,0,0" Classes="dkMuted" FontSize="12" Text="{Binding Node.DefinedIn}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Node.DefinedIn}" />
          <CheckBox Margin="32,2,0,0" Content="The Claude Code sessions VSL starts get it" IsChecked="{Binding ForClaude}"
                    IsEnabled="{Binding CanSwitchForClaude}" ToolTip.Tip="{Binding ForClaudeTip}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
          <Button Classes="dkOutline" Command="{Binding AskClaudeCommand}" IsVisible="{Binding Node.HasFailed}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:VsIcon Kind="Claude" Width="13" Height="13" />
              <TextBlock Text="Ask Claude" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="McpConnectAgain" Classes="dkOutline" Command="{Binding ConnectAgainCommand}" Content="Connect again" />
          <Button Classes="dkIcon" Command="{Binding EditCommand}" ToolTip.Tip="Edit…">
            <v:VsIcon Kind="Pencil" />
          </Button>
        </StackPanel>
      </Grid>

      <Border BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
          <Button Name="McpToolsTab" Classes="dkTab" Classes.selected="{Binding IsTools}" Command="{Binding ShowTabCommand}" CommandParameter="tools" Content="Tools" />
          <Button Name="McpResourcesTab" Classes="dkTab" Classes.selected="{Binding IsResources}" Command="{Binding ShowTabCommand}" CommandParameter="resources" Content="Resources" />
          <Button Name="McpPromptsTab" Classes="dkTab" Classes.selected="{Binding IsPrompts}" Command="{Binding ShowTabCommand}" CommandParameter="prompts" Content="Prompts" />
          <Button Name="McpLogTab" Classes="dkTab" Classes.selected="{Binding IsLog}" Command="{Binding ShowTabCommand}" CommandParameter="log" Content="Log" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Panel Margin="0,12,0,14">
      <!-- Not connected: what it is, where the lists would be -->
      <StackPanel IsVisible="{Binding ShowsWaiting}" Spacing="10" Margin="2,4" ZIndex="1" Background="#1E1E1E">
        <SelectableTextBlock Text="{Binding Waiting}" TextWrapping="Wrap" Classes="dkMuted" />
        <TextBlock Classes="dkMuted" FontSize="12" TextWrapping="Wrap" Text="The Log says what the server said (its stderr too)." />
      </StackPanel>
      <TextBlock IsVisible="{Binding ShowsNothing}" Classes="dkMuted" Text="It offers no tools, resources or prompts." Margin="2,4" ZIndex="1" />

      <!-- ===== Tools ===== -->
      <Grid ColumnDefinitions="260,*" IsVisible="{Binding IsTools}">
        <ListBox Name="McpToolList" Classes="items" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:McpToolItem">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource VsCodeFont}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" Classes="dkMuted" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Margin="16,0,8,0" Content="{Binding SelectedTool}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="mvm:McpToolItem">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="760" />
                  </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                  <TextBlock Classes="itemName" Text="{Binding Name}" />
                  <SelectableTextBlock Text="{Binding Description}" Classes="dkMuted" FontSize="12.5" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Hints}" Classes="dkMuted" FontSize="11.5" FontStyle="Italic" IsVisible="{Binding Hints, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="section" Text="ARGUMENTS" />
                  <TextBlock Classes="dkMuted" Text="It takes no arguments." IsVisible="{Binding Form.IsEmpty}" />
                  <ItemsControl Name="McpArguments" ItemsSource="{Binding Form.Fields}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Name="McpRun" Classes="dkPrimary" Command="{Binding RunCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <v:VsIcon Kind="DockerPlay" Width="12" Height="12" />
                        <TextBlock Text="Run" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Classes="dkOutline" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" Content="Cancel" />
                  </StackPanel>
                  <TextBox Name="McpResult" Classes="reply" Classes.error="{Binding IsError}" Text="{Binding Result}" IsVisible="{Binding HasResult}" />
                </StackPanel>
                </Grid>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Grid>

      <!-- ===== Resources ===== -->
      <Grid ColumnDefinitions="260,*" IsVisible="{Binding IsResources}">
        <ListBox Classes="items" ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:McpResourceItem">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource VsCodeFont}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Uri}" Classes="dkMuted" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Margin="16,0,8,0" Content="{Binding SelectedResource}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="mvm:McpResourceItem">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="760" />
                  </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                  <TextBlock Classes="itemName" Text="{Binding Name}" />
                  <SelectableTextBlock Text="{Binding Uri}" Classes="dkMuted dkMono" />
                  <SelectableTextBlock Text="{Binding Description}" Classes="dkMuted" FontSize="12.5" TextWrapping="Wrap" />
                  <Button Name="McpRead" Classes="dkPrimary" Command="{Binding ReadCommand}" Content="Read" HorizontalAlignment="Left" Margin="0,10,0,0" />
                  <TextBox Name="McpContent" Classes="reply" Classes.error="{Binding IsError}" Text="{Binding Content}" IsVisible="{Binding HasContent}" />
                </StackPanel>
                </Grid>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Grid>

      <!-- ===== Prompts ===== -->
      <Grid ColumnDefinitions="260,*" IsVisible="{Binding IsPrompts}">
        <ListBox Classes="items" ItemsSource="{Binding Prompts}" SelectedItem="{Binding SelectedPrompt}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="mvm:McpPromptItem">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource VsCodeFont}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" Classes="dkMuted" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Margin="16,0,8,0" Content="{Binding SelectedPrompt}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="mvm:McpPromptItem">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="760" />
                  </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                  <TextBlock Classes="itemName" Text="{Binding Name}" />
                  <SelectableTextBlock Text="{Binding Description}" Classes="dkMuted" FontSize="12.5" TextWrapping="Wrap" />
                  <TextBlock Classes="section" Text="ARGUMENTS" />
                  <TextBlock Classes="dkMuted" Text="It takes no arguments." IsVisible="{Binding Form.IsEmpty}" />
                  <ItemsControl ItemsSource="{Binding Form.Fields}" />
                  <Button Name="McpGet" Classes="dkPrimary" Command="{Binding GetCommand}" Content="Get" HorizontalAlignment="Left" Margin="0,4,0,0" />
                  <TextBox Name="McpMessages" Classes="reply" Classes.error="{Binding IsError}" Text="{Binding Messages}" IsVisible="{Binding HasMessages}" />
                </StackPanel>
                </Grid>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Grid>

      <!-- ===== Log: requests (→), responses (←), the server's stderr, errors ===== -->
      <Border IsVisible="{Binding IsLog}" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <ae:TextEditor Name="LogEditor" FontFamily="{StaticResource VsCodeFont}" FontSize="12" Background="#181818" Foreground="#D4D4D4"
                       Padding="10,6" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" WordWrap="True" />
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
