<!--
  The Database Explorer's look (Bengine Data Studio's views, in VSL's colors). Its classes (tool, ghost, primary, dim,
  faint, mono...) apply where the database views use them; the styles of whole control types (data grids, tabs) only
  inside them (the "dbx" class on the explorer, the database documents and the database dialogs).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="Bg">#1E1E1E</SolidColorBrush>
    <SolidColorBrush x:Key="Panel">#252526</SolidColorBrush>
    <SolidColorBrush x:Key="Panel2">#2D2D30</SolidColorBrush>
    <SolidColorBrush x:Key="Line">#3F3F46</SolidColorBrush>
    <SolidColorBrush x:Key="LineSoft">#333337</SolidColorBrush>
    <SolidColorBrush x:Key="Dim">#A0A0A0</SolidColorBrush>
    <SolidColorBrush x:Key="Faint">#7A7A7A</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#007ACC</SolidColorBrush>
    <SolidColorBrush x:Key="Danger">#F48771</SolidColorBrush>
    <SolidColorBrush x:Key="Ok">#89D185</SolidColorBrush>
    <FontFamily x:Key="Mono">avares://VSL/Assets/Fonts#Cascadia Mono, DejaVu Sans Mono, Noto Sans Mono, monospace</FontFamily>
  </Styles.Resources>

  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

  <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="{StaticResource Dim}" /></Style>
  <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{StaticResource Faint}" /></Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
  </Style>
  <Style Selector=".dbx Button.primary">
    <Setter Property="Background" Value="#0E639C" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=".dbx Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1177BB" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="28" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="ToggleButton.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineSoft}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Border.sep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>

  <!-- Whole control types: inside the database views only -->
  <Style Selector=".dbx DataGrid">
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineSoft}" />
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource LineSoft}" />
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="RowHeight" Value="24" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="RowHeaderWidth" Value="46" />
  </Style>
  <Style Selector=".dbx DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource Panel2}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=".dbx TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,4" />
  </Style>
  <Style Selector=".dbx TabStripItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
</Styles>
