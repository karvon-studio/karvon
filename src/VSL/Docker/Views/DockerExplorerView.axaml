<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:VSL.Views"
             xmlns:dvm="using:VSL.Docker.ViewModels"
             x:Class="VSL.Docker.Views.DockerExplorerView"
             x:DataType="dvm:DockerExplorerViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://VSL/Docker/Views/DockerStyles.axaml" />
    <Style Selector="TreeView#Tree TreeViewItem" x:DataType="dvm:DockerTreeItem">
      <Setter Property="IsExpanded" Value="{Binding IsTreeExpanded, Mode=TwoWay}" />
    </Style>
    <!-- A row as wide as the tree: the name trims, a container's start / stop sits at the right edge. -->
    <Style Selector="TreeView#Tree TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid.dkNode">
      <Setter Property="Height" Value="22" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.dkNode TextBlock.detail">
      <Setter Property="Foreground" Value="#9D9D9D" />
    </Style>
    <!-- A container's start / stop shows on hover, as Git Changes' row buttons. -->
    <Style Selector="Grid.dkNode StackPanel.rowActions">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.dkNode:pointerover StackPanel.rowActions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid.dkNode Button.tbi">
      <Setter Property="Padding" Value="3" />
      <Setter Property="MinHeight" Value="18" />
    </Style>
    <Style Selector="Grid.dkNode Button.tbi v|VsIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}">
      <TextBlock Classes="toolTitle" Text="Docker Explorer" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="4,2">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Name="RefreshButton" Classes="tbi" Command="{Binding RefreshAllCommand}" IsEnabled="{Binding IsEngineRunning}" ToolTip.Tip="Refresh">
          <v:VsIcon Kind="Refresh" />
        </Button>
        <Button Classes="tbi" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse All">
          <v:VsIcon Kind="CollapseAll" />
        </Button>
      </StackPanel>
    </Border>
    <TextBox Name="FilterBox" DockPanel.Dock="Top" Classes="search" Margin="4,0,4,4" Text="{Binding Filter}" PlaceholderText="Search Docker Explorer"
             IsVisible="{Binding IsEngineRunning}" />

    <!-- The engine, and what the running containers use (Docker Desktop's status bar) -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="8,4,8,5" ToolTip.Tip="{Binding MachineText}">
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="dot" Classes.running="{Binding IsEngineRunning}" Classes.failing="{Binding IsEngineStopped}" Width="7" Height="7" />
            <TextBlock Name="EngineStatus" Text="{Binding EngineStatusText}" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="11" Classes="dkMuted" HorizontalAlignment="Right" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
        </Grid>
        <TextBlock FontSize="11" Classes="dkMuted" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsEngineRunning}">
          <Run Text="{Binding RamText}" /><Run Text="  ·  " /><Run Text="{Binding CpuText}" /><Run Text="  ·  " /><Run Text="{Binding DiskText}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <Panel>
      <TextBlock IsVisible="{Binding IsEngineStarting}" Text="Connecting to the Docker engine…" Classes="dkMuted" Margin="12,10" TextWrapping="Wrap" />

      <!-- Not installed, not running, or no access -->
      <StackPanel Name="EngineStopped" IsVisible="{Binding IsEngineStopped}" Margin="12,10" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:VsIcon Kind="Docker" Width="20" Height="20" Foreground="#5A6270" />
          <TextBlock Text="The Docker engine is not available" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <SelectableTextBlock Text="{Binding EngineMessage}" TextWrapping="Wrap" Classes="dkMuted dkMono" FontSize="11" />
        <TextBlock Text="{Binding EngineHint}" TextWrapping="Wrap" IsVisible="{Binding EngineHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Name="RetryButton" Classes="dkPrimary" HorizontalAlignment="Left" Command="{Binding RetryCommand}" Content="Retry" />
      </StackPanel>

      <TreeView Name="Tree" ItemsSource="{Binding Sections}" IsVisible="{Binding IsEngineRunning}" Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.DataTemplates>
          <!-- Containers, Images, Volumes, Networks: double-click opens the table -->
          <TreeDataTemplate DataType="dvm:DockerSectionNode" ItemsSource="{Binding Items}">
            <Grid Classes="dkNode" ColumnDefinitions="Auto,*">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding Title, StringFormat=Open {0}}" Command="{Binding OpenCommand}" FontWeight="SemiBold" />
                  <MenuItem Header="Refresh" Command="{Binding Explorer.RefreshAllCommand}" />
                  <Separator IsVisible="{Binding HasCompose}" />
                  <MenuItem Header="Compose Up" Command="{Binding Explorer.Containers.ComposeUpCommand}" IsVisible="{Binding HasCompose}" />
                  <MenuItem Header="Compose Down" Command="{Binding Explorer.Containers.ComposeDownCommand}" IsVisible="{Binding HasCompose}" />
                  <Separator IsVisible="{Binding !IsContainers}" />
                  <MenuItem Header="Clean Up Unused Images…" Command="{Binding Explorer.Images.CleanUpCommand}" IsVisible="{Binding IsImages}" />
                  <MenuItem Header="Create Volume…" Command="{Binding Explorer.Volumes.CreateCommand}" IsVisible="{Binding IsVolumes}" />
                  <MenuItem Header="Create Network…" Command="{Binding Explorer.Networks.CreateCommand}" IsVisible="{Binding IsNetworks}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <v:VsIcon Kind="{Binding Icon}" Width="15" Height="15" Foreground="#4DAAFC" />
              <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Title}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Count}" Foreground="#9D9D9D" />
              </TextBlock>
            </Grid>
          </TreeDataTemplate>

          <!-- A compose project -->
          <TreeDataTemplate DataType="dvm:StackRow" ItemsSource="{Binding TreeChildren}">
            <Grid Classes="dkNode" ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{Binding StateText}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding StartStopTip}" Command="{Binding StartStopCommand}" IsEnabled="{Binding IsIdle}" />
                  <MenuItem Header="Restart" Command="{Binding RestartCommand}" IsEnabled="{Binding IsIdle}" />
                  <Separator />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsIdle}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <v:VsIcon Kind="DockerStack" Width="15" Height="15" Classes="state"
                        Classes.running="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=running}"
                        Classes.paused="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=paused}"
                        Classes.failing="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=failing}" />
              <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding TreeText}" Foreground="#9D9D9D" />
              </TextBlock>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
                <v:VsIcon Kind="Warning" Width="13" Height="13" IsVisible="{Binding HasProblems}" ToolTip.Tip="{Binding ProblemsText}" />
                <Border Classes="pill blue" IsVisible="{Binding IsThisSolution}" Padding="6,0">
                  <TextBlock Text="This solution" FontSize="10" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="3" Classes="rowActions" Orientation="Horizontal" Margin="4,0,0,0">
                <Button Classes="tbi" Command="{Binding StartStopCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{Binding StartStopTip}">
                  <Panel>
                    <v:VsIcon Kind="DockerStop" IsVisible="{Binding IsUp}" />
                    <v:VsIcon Kind="DockerPlay" IsVisible="{Binding !IsUp}" />
                  </Panel>
                </Button>
              </StackPanel>
            </Grid>
          </TreeDataTemplate>

          <DataTemplate DataType="dvm:ContainerRow">
            <Grid Classes="dkNode" ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{Binding Image}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open" Command="{Binding OpenCommand}" FontWeight="SemiBold" />
                  <MenuItem Header="Open Shell" Command="{Binding OpenTabCommand}" CommandParameter="exec" IsEnabled="{Binding IsRunning}" />
                  <MenuItem Header="Inspect" Command="{Binding OpenTabCommand}" CommandParameter="inspect" />
                  <MenuItem Header="Stats" Command="{Binding OpenTabCommand}" CommandParameter="stats" IsEnabled="{Binding IsRunning}" />
                  <Separator />
                  <MenuItem Header="{Binding StartStopTip}" Command="{Binding StartStopCommand}" IsEnabled="{Binding IsIdle}" />
                  <MenuItem Header="Restart" Command="{Binding RestartCommand}" IsEnabled="{Binding IsIdle}" />
                  <MenuItem Header="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding IsUp}" />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsIdle}" />
                  <Separator />
                  <MenuItem Header="Open in Browser" Command="{Binding OpenPortCommand}" IsVisible="{Binding HasPorts}" />
                  <MenuItem Header="Open Image" Command="{Binding OpenImageCommand}" />
                  <MenuItem Header="Ask Claude" Command="{Binding AskClaudeCommand}" />
                  <MenuItem Header="Copy Container ID" Click="OnCopy" Tag="{Binding Container.Id}" />
                  <MenuItem Header="Copy Name" Click="OnCopy" Tag="{Binding Name}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <v:VsIcon Kind="DockerContainer" Width="15" Height="15" Classes="state"
                        Classes.running="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=running}"
                        Classes.paused="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=paused}"
                        Classes.failing="{Binding StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=failing}" />
              <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding TreeText}" Foreground="#9D9D9D" /><Run Text="  " /><Run Text="{Binding BusyText}" Foreground="#79A6F6" />
              </TextBlock>
              <v:VsIcon Grid.Column="2" Kind="Warning" Width="13" Height="13" Margin="4,0,0,0" IsVisible="{Binding HasProblems}" ToolTip.Tip="{Binding ProblemsText}" />
              <StackPanel Grid.Column="3" Classes="rowActions" Orientation="Horizontal" Margin="4,0,0,0">
                <Button Classes="tbi" Command="{Binding StartStopCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{Binding StartStopTip}">
                  <Panel>
                    <v:VsIcon Kind="DockerStop" IsVisible="{Binding IsUp}" />
                    <v:VsIcon Kind="DockerPlay" IsVisible="{Binding !IsUp}" />
                  </Panel>
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>

          <DataTemplate DataType="dvm:ImageRow">
            <Grid Classes="dkNode" ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding StatusText}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open" Command="{Binding OpenCommand}" FontWeight="SemiBold" />
                  <MenuItem Header="Run…" Command="{Binding RunCommand}" />
                  <Separator />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding !IsBusy}" />
                  <Separator />
                  <MenuItem Header="Copy Image ID" Click="OnCopy" Tag="{Binding Image.Id}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <v:VsIcon Kind="DockerImage" Width="15" Height="15" Classes="state" Classes.running="{Binding InUse}" />
              <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Reference}" /><Run Text="  " /><Run Text="{Binding SizeText}" Foreground="#9D9D9D" />
              </TextBlock>
            </Grid>
          </DataTemplate>

          <DataTemplate DataType="dvm:VolumeRow">
            <Grid Classes="dkNode" ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Name}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open" Command="{Binding OpenCommand}" FontWeight="SemiBold" />
                  <Separator />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding !IsBusy}" />
                  <Separator />
                  <MenuItem Header="Copy Name" Click="OnCopy" Tag="{Binding Name}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <v:VsIcon Kind="DockerVolume" Width="15" Height="15" Classes="state" Classes.running="{Binding InUse}" />
              <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding TreeName}" /><Run Text="  " /><Run Text="{Binding SizeText}" Foreground="#9D9D9D" />
              </TextBlock>
            </Grid>
          </DataTemplate>

          <DataTemplate DataType="dvm:NetworkRow">
            <Grid Classes="dkNode" ColumnDefinitions="Auto,*">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open" Command="{Binding OpenCommand}" FontWeight="SemiBold" />
                  <Separator />
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" />
                  <Separator />
                  <MenuItem Header="Copy Network ID" Click="OnCopy" Tag="{Binding Network.Id}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <v:VsIcon Kind="DockerNetwork" Width="15" Height="15" Classes="state" Classes.running="{Binding HasContainers}" />
              <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Driver}" Foreground="#9D9D9D" />
              </TextBlock>
            </Grid>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
    </Panel>
  </DockPanel>
</UserControl>
