<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:VSL.Views"
             xmlns:dvm="using:VSL.Docker.ViewModels"
             xmlns:dv="using:VSL.Docker.Views"
             x:Class="VSL.Docker.Views.DockerExplorerView"
             x:DataType="dvm:DockerExplorerViewModel"
             Background="#1E1E1E">
  <UserControl.Styles>
    <StyleInclude Source="avares://VSL/Docker/Views/DockerStyles.axaml" />
  </UserControl.Styles>

  <Panel>
    <DockPanel>
      <!-- ===== Footer: the engine, and what the containers use (Docker Desktop's status bar) ===== -->
      <Border DockPanel.Dock="Bottom" Height="28" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Name="EngineStatus" Classes="pill" Classes.green="{Binding IsEngineRunning}" Classes.red="{Binding IsEngineStopped}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Classes="dot" Classes.running="{Binding IsEngineRunning}" Classes.failing="{Binding IsEngineStopped}" Width="7" Height="7" />
                <TextBlock Text="{Binding EngineStatusText}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsEngineRunning}">
              <TextBlock Text="{Binding RamText}" FontSize="11" Classes="dkMuted" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CpuText}" FontSize="11" Classes="dkMuted" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DiskText}" FontSize="11" Classes="dkMuted" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding MachineText}" FontSize="11" Classes="dkMuted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding VersionText}" FontSize="11" Classes="dkMuted" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Sidebar ===== -->
      <Border DockPanel.Dock="Left" Width="208" Background="#252526" BorderBrush="#333337" BorderThickness="0,0,1,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="9" Margin="18,16,16,14">
            <v:VsIcon Kind="Docker" Width="24" Height="24" Foreground="#2496ED" />
            <TextBlock Text="Docker" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <Button Name="NavContainers" Classes="dkNav" Classes.selected="{Binding IsContainers}" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static dvm:DockerSection.Containers}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <v:VsIcon Kind="DockerContainer" Width="17" Height="17" />
              <TextBlock Grid.Column="1" Text="Containers" Margin="11,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Containers.Count}" FontSize="11" Classes="dkMuted" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Name="NavImages" Classes="dkNav" Classes.selected="{Binding IsImages}" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static dvm:DockerSection.Images}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <v:VsIcon Kind="DockerImage" Width="17" Height="17" />
              <TextBlock Grid.Column="1" Text="Images" Margin="11,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Images.Count}" FontSize="11" Classes="dkMuted" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Name="NavVolumes" Classes="dkNav" Classes.selected="{Binding IsVolumes}" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static dvm:DockerSection.Volumes}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <v:VsIcon Kind="DockerVolume" Width="17" Height="17" />
              <TextBlock Grid.Column="1" Text="Volumes" Margin="11,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Volumes.Count}" FontSize="11" Classes="dkMuted" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Name="NavNetworks" Classes="dkNav" Classes.selected="{Binding IsNetworks}" Command="{Binding ShowSectionCommand}" CommandParameter="{x:Static dvm:DockerSection.Networks}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <v:VsIcon Kind="DockerNetwork" Width="17" Height="17" />
              <TextBlock Grid.Column="1" Text="Networks" Margin="11,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Networks.Count}" FontSize="11" Classes="dkMuted" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <!-- ===== Content ===== -->
      <DockPanel>
        <!-- What the engine said when something failed -->
        <Border Name="ErrorBanner" DockPanel.Dock="Top" IsVisible="{Binding HasError}" Background="#3D1C1E" BorderBrush="#7A2E32" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,8,10,8">
            <v:VsIcon Kind="Error" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" Foreground="#FFB4AE" />
            <Button Grid.Column="2" Classes="dkIcon" Width="24" Height="24" Command="{Binding DismissErrorCommand}" ToolTip.Tip="Dismiss">
              <v:VsIcon Kind="Close" Width="12" Height="12" />
            </Button>
          </Grid>
        </Border>

        <Panel>
          <!-- Asking the engine for the first time -->
          <StackPanel IsVisible="{Binding IsEngineStarting}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <v:VsIcon Kind="Docker" Width="48" Height="48" Foreground="#2496ED" HorizontalAlignment="Center" />
            <TextBlock Text="Connecting to the Docker engine…" Classes="dkMuted" HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Not installed, not running, or no access -->
          <Border Name="EngineStopped" IsVisible="{Binding IsEngineStopped}" Classes="dkCard" Padding="28,24" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12">
              <v:VsIcon Kind="Docker" Width="48" Height="48" Foreground="#5A6270" HorizontalAlignment="Center" />
              <TextBlock Text="The Docker engine is not available" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <SelectableTextBlock Text="{Binding EngineMessage}" TextWrapping="Wrap" Classes="dkMuted dkMono" TextAlignment="Center" />
              <TextBlock Text="{Binding EngineHint}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding EngineHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Button Name="RetryButton" Classes="dkPrimary" HorizontalAlignment="Center" Command="{Binding RetryCommand}" Content="Retry" />
            </StackPanel>
          </Border>

          <Panel IsVisible="{Binding ShowContainers}">
            <dv:DockerContainersView Name="ContainersView" DataContext="{Binding Containers}" />
          </Panel>
          <Panel IsVisible="{Binding ShowImages}">
            <dv:DockerImagesView Name="ImagesView" DataContext="{Binding Images}" />
          </Panel>
          <Panel IsVisible="{Binding ShowVolumes}">
            <dv:DockerVolumesView Name="VolumesView" DataContext="{Binding Volumes}" />
          </Panel>
          <Panel IsVisible="{Binding ShowNetworks}">
            <dv:DockerNetworksView Name="NetworksView" DataContext="{Binding Networks}" />
          </Panel>

          <!-- A container's, image's, volume's or network's page -->
          <ContentControl Name="DetailHost" Content="{Binding Detail}" IsVisible="{Binding ShowDetail}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="dvm:ContainerDetailViewModel">
                <dv:DockerContainerView />
              </DataTemplate>
              <DataTemplate DataType="dvm:ImageDetailViewModel">
                <dv:DockerImageView />
              </DataTemplate>
              <DataTemplate DataType="dvm:VolumeDetailViewModel">
                <dv:DockerVolumeView />
              </DataTemplate>
              <DataTemplate DataType="dvm:NetworkDetailViewModel">
                <dv:DockerNetworkView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Panel>
      </DockPanel>
    </DockPanel>

    <!-- ===== Dialogs, over everything ===== -->
    <Panel Name="DialogLayer" IsVisible="{Binding HasDialog}" Background="#99000000">
      <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="dvm:ConfirmDialog">
            <Border Classes="dkCard" Width="440" Padding="22,18" Background="#2B2B2F">
              <StackPanel Spacing="14">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="dkMuted" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                  <Button Name="ConfirmButton" Classes="dkPrimary" Classes.dkDanger="{Binding IsDanger}" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsDefault="True" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="dvm:InputDialog">
            <Border Classes="dkCard" Width="420" Padding="22,18" Background="#2B2B2F">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding Label}" Classes="dkMuted" />
                  <TextBox Name="InputText" Classes="dkField" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" />
                </StackPanel>
                <StackPanel Spacing="5" IsVisible="{Binding HasChoices}">
                  <TextBlock Text="Driver" Classes="dkMuted" />
                  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" MinWidth="160" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                  <Button Classes="dkPrimary" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsDefault="True" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="dvm:RunDialog">
            <dv:DockerRunDialog />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Panel>
  </Panel>
</UserControl>
