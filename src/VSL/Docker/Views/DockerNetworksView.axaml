<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:VSL.Views"
             xmlns:dvm="using:VSL.Docker.ViewModels"
             xmlns:dv="using:VSL.Docker.Views"
             x:Class="VSL.Docker.Views.DockerNetworksView"
             x:DataType="dvm:NetworksPage">
  <DockPanel Margin="26,20,26,0">
    <StackPanel DockPanel.Dock="Top" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="dkTitle" Text="Networks" />
          <TextBlock Classes="dkSubtitle" Text="How containers reach each other: compose makes one per project." />
        </StackPanel>
        <Button Name="CreateNetworkButton" Grid.Column="1" Classes="dkPrimary" Command="{Binding CreateCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <v:VsIcon Kind="Plus" Width="13" Height="13" />
            <TextBlock Text="Create" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <Panel Height="34">
        <Panel Width="300" HorizontalAlignment="Left" IsVisible="{Binding !HasSelection}">
          <TextBox Name="SearchBox" Classes="dkSearch" Text="{Binding Search}" PlaceholderText="Search" />
          <v:VsIcon Kind="Search" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="#9D9D9D" />
        </Panel>
        <Border IsVisible="{Binding HasSelection}" Background="#1F2E4D" CornerRadius="6" Padding="12,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Classes="dkOutline" Command="{Binding DeleteSelectedCommand}" Content="Delete" Foreground="#FF7B72" />
            </StackPanel>
            <Button Grid.Column="2" Classes="dkIcon" Width="26" Height="26" Command="{Binding ClearSelectionCommand}" ToolTip.Tip="Clear selection">
              <v:VsIcon Kind="Close" Width="12" Height="12" />
            </Button>
          </Grid>
        </Border>
      </Panel>
    </StackPanel>

    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
      <Border Classes="dkTableHeader">
        <dv:DockerColumns Layout="40,*180,124?1,90?4,70?2,100?5,120?3,80">
          <CheckBox Classes="dkCheck" IsChecked="{Binding AllSelected}" ToolTip.Tip="Select all" />
          <TextBlock dv:DockerColumns.Column="1" Text="Name" Classes="dkHeader" />
          <TextBlock dv:DockerColumns.Column="2" Text="Network ID" Classes="dkHeader" />
          <TextBlock dv:DockerColumns.Column="3" Text="Driver" Classes="dkHeader" />
          <TextBlock dv:DockerColumns.Column="4" Text="Scope" Classes="dkHeader" />
          <TextBlock dv:DockerColumns.Column="5" Text="Containers" Classes="dkHeader" />
          <TextBlock dv:DockerColumns.Column="6" Text="Created" Classes="dkHeader" />
          <TextBlock dv:DockerColumns.Column="7" Text="Actions" Classes="dkHeader" HorizontalAlignment="Right" Margin="0,0,12,0" />
        </dv:DockerColumns>
      </Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <ItemsControl Name="Table" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dvm:NetworkRow">
                <Border Classes="dkRow" Classes.selected="{Binding IsSelected}" DoubleTapped="OnRowDoubleTapped">
                  <dv:DockerColumns Layout="40,*180,124?1,90?4,70?2,100?5,120?3,80">
                    <CheckBox Classes="dkCheck" IsChecked="{Binding IsSelected}" IsVisible="{Binding CanDelete}" />
                    <StackPanel dv:DockerColumns.Column="1" Orientation="Horizontal" Spacing="10">
                      <v:VsIcon Kind="DockerNetwork" Width="18" Height="18" Classes="state" Classes.running="{Binding HasContainers}" />
                      <StackPanel VerticalAlignment="Center">
                        <Button Classes="dkLink plain" Command="{Binding OpenCommand}" ToolTip.Tip="View details">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <TextBlock Text="{Binding Project, StringFormat='compose project {0}'}" FontSize="11" Classes="dkMuted"
                                   IsVisible="{Binding Project, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock dv:DockerColumns.Column="2" Classes="dkCell dkMono" Text="{Binding ShortId}" />
                    <TextBlock dv:DockerColumns.Column="3" Classes="dkCell" Text="{Binding Driver}" />
                    <TextBlock dv:DockerColumns.Column="4" Classes="dkCell" Text="{Binding Scope}" />
                    <TextBlock dv:DockerColumns.Column="5" Classes="dkCell" Text="{Binding ContainersText}" />
                    <TextBlock dv:DockerColumns.Column="6" Classes="dkCell" Text="{Binding CreatedText}" />
                    <StackPanel dv:DockerColumns.Column="7" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" Margin="0,0,4,0">
                      <Button Classes="dkIcon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" IsEnabled="{Binding CanDelete}">
                        <v:VsIcon Kind="DockerDelete" />
                      </Button>
                    </StackPanel>
                  </dv:DockerColumns>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding HasNoMatches}" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="8">
            <TextBlock Text="No networks match" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Button Classes="dkLink" HorizontalAlignment="Center" Command="{Binding ClearSearchCommand}">
              <TextBlock Text="Clear the search" />
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
