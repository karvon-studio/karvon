<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:VSL.Views"
             xmlns:dvm="using:VSL.Docker.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="VSL.Docker.Views.DockerVolumeView"
             x:DataType="dvm:VolumeDetailViewModel">
  <DockPanel Margin="20,14,20,0">
    <StackPanel DockPanel.Dock="Top" Spacing="12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="dkIcon" Command="{Binding BackCommand}" ToolTip.Tip="Back to Volumes (Esc)" VerticalAlignment="Top">
          <v:VsIcon Kind="DockerBack" />
        </Button>
        <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <v:VsIcon Kind="DockerVolume" Width="22" Height="22" Classes="state" Classes.running="{Binding Row.InUse}" />
            <TextBlock Name="VolumeName" Text="{Binding Row.Name}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Classes="pill green" IsVisible="{Binding Row.InUse}">
              <TextBlock Text="In use" />
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="18" Margin="32,0,0,0">
            <TextBlock Text="{Binding Row.SizeText}" Classes="dkMuted" />
            <TextBlock Text="{Binding Row.Driver, StringFormat='Driver {0}'}" Classes="dkMuted" />
            <TextBlock Text="{Binding Row.CreatedText, StringFormat='Created {0}'}" Classes="dkMuted" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="2" Classes="dkIcon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" VerticalAlignment="Top">
          <v:VsIcon Kind="DockerDelete" />
        </Button>
      </Grid>
      <Border BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
          <Button Classes="dkTab" Classes.selected="{Binding IsContainers}" Command="{Binding ShowTabCommand}" CommandParameter="containers" Content="Container in-use" />
          <Button Classes="dkTab" Classes.selected="{Binding IsInspect}" Command="{Binding ShowTabCommand}" CommandParameter="inspect" Content="Inspect" />
        </StackPanel>
      </Border>
    </StackPanel>
    <Panel Margin="0,10,0,14">
      <StackPanel IsVisible="{Binding IsContainers}">
        <ItemsControl ItemsSource="{Binding UsedBy}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dvm:ContainerRow">
              <Border Classes="dkRow" MinHeight="40">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0">
                  <Ellipse Classes="dot" Classes.running="{Binding IsRunning}" Classes.failing="{Binding IsFailing}" />
                  <Button Classes="dkLink plain" Command="{Binding $parent[UserControl].((dvm:VolumeDetailViewModel)DataContext).OpenContainerCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  </Button>
                  <TextBlock Text="{Binding Image}" Classes="dkMuted" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StateText}" Classes="dkMuted" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No container mounts this volume." Classes="dkMuted" Margin="8,14" IsVisible="{Binding IsUnused}" />
      </StackPanel>
      <Border IsVisible="{Binding IsInspect}" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <ae:TextEditor Name="InspectEditor" FontFamily="{StaticResource VsCodeFont}" FontSize="12" Background="#181818" Padding="10,6"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
