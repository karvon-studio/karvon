<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:VSL.Views"
             xmlns:d="using:VSL.Docker"
             xmlns:dv="using:VSL.Docker.Views"
             xmlns:dvm="using:VSL.Docker.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="VSL.Docker.Views.DockerContainerView"
             x:DataType="dvm:ContainerDetailViewModel">
  <DockPanel Margin="20,14,20,0">
    <StackPanel DockPanel.Dock="Top" Spacing="12">
      <!-- The container, its state and actions -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <v:VsIcon Kind="DockerContainer" Width="22" Height="22" Classes="state"
                      Classes.running="{Binding Row.StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=running}"
                      Classes.paused="{Binding Row.StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=paused}"
                      Classes.failing="{Binding Row.StateKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=failing}" />
            <TextBlock Name="ContainerName" Text="{Binding Row.Name}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="pill" Classes.green="{Binding Row.IsRunning}" Classes.red="{Binding Row.IsFailing}">
              <TextBlock Name="StatusText" Text="{Binding StatusText}" />
            </Border>
            <TextBlock Text="{Binding Row.BusyText}" Foreground="#79A6F6" VerticalAlignment="Center" IsVisible="{Binding Row.IsBusy}" />
          </StackPanel>
          <WrapPanel Margin="32,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,18,0">
              <TextBlock Text="{Binding Row.ShortId}" Classes="dkMono dkMuted" VerticalAlignment="Center" />
              <Button Classes="dkIcon" Width="22" Height="22" Click="OnCopy" Tag="{Binding Row.Container.Id}" ToolTip.Tip="Copy the container ID">
                <v:VsIcon Kind="Copy" Width="12" Height="12" />
              </Button>
            </StackPanel>
            <Button Classes="dkLink" Command="{Binding OpenImageCommand}" Margin="0,0,18,0" ToolTip.Tip="The image">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <v:VsIcon Kind="DockerImage" Width="13" Height="13" />
                <TextBlock Text="{Binding Row.Image}" />
              </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Row.Ports}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="d:DockerPort">
                  <Button Classes="dkLink" Command="{Binding $parent[UserControl].((dvm:ContainerDetailViewModel)DataContext).OpenPortCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding Url}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                      <TextBlock Text="{Binding Text}" />
                      <v:VsIcon Kind="DockerLink" Width="11" Height="11" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
          <Button Name="AskClaudeButton" Classes="dkOutline" Command="{Binding AskClaudeCommand}" ToolTip.Tip="Claude Code, with its state and last log lines">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:VsIcon Kind="Claude" Width="13" Height="13" />
              <TextBlock Text="{Binding AskClaudeText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="OpenInDatabaseButton" Classes="dkOutline" Command="{Binding OpenInDatabaseExplorerCommand}" IsVisible="{Binding IsDatabase}"
                  ToolTip.Tip="A data source of the Database Explorer, from its published port and variables">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:VsIcon Kind="DockerVolume" Width="13" Height="13" />
              <TextBlock Text="Open in Database Explorer" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="StartStopButton" Classes="dkPrimary" Command="{Binding StartStopCommand}" IsEnabled="{Binding Row.IsIdle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Panel>
                <v:VsIcon Kind="DockerStop" Width="13" Height="13" IsVisible="{Binding Row.IsUp}" />
                <v:VsIcon Kind="DockerPlay" Width="13" Height="13" IsVisible="{Binding !Row.IsUp}" />
              </Panel>
              <TextBlock Text="{Binding Row.StartStopTip}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="dkIcon" Command="{Binding RestartCommand}" ToolTip.Tip="Restart" IsEnabled="{Binding Row.IsIdle}">
            <v:VsIcon Kind="DockerRestart" />
          </Button>
          <Button Classes="dkIcon" Command="{Binding PauseResumeCommand}" ToolTip.Tip="Pause or resume" IsEnabled="{Binding Row.IsUp}">
            <Panel>
              <v:VsIcon Kind="DockerPause" IsVisible="{Binding !Row.IsPaused}" />
              <v:VsIcon Kind="DockerPlay" IsVisible="{Binding Row.IsPaused}" />
            </Panel>
          </Button>
          <Button Name="DeleteButton" Classes="dkIcon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" IsEnabled="{Binding Row.IsIdle}">
            <v:VsIcon Kind="DockerDelete" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Tabs -->
      <Border BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
          <Button Name="LogsTab" Classes="dkTab" Classes.selected="{Binding IsLogs}" Command="{Binding ShowTabCommand}" CommandParameter="logs" Content="Logs" />
          <Button Name="InspectTab" Classes="dkTab" Classes.selected="{Binding IsInspect}" Command="{Binding ShowTabCommand}" CommandParameter="inspect" Content="Inspect" />
          <Button Name="MountsTab" Classes="dkTab" Classes.selected="{Binding IsMounts}" Command="{Binding ShowTabCommand}" CommandParameter="mounts" Content="Bind mounts" />
          <Button Name="ExecTab" Classes="dkTab" Classes.selected="{Binding IsExec}" Command="{Binding ShowTabCommand}" CommandParameter="exec" Content="Exec" />
          <Button Name="StatsTab" Classes="dkTab" Classes.selected="{Binding IsStats}" Command="{Binding ShowTabCommand}" CommandParameter="stats" Content="Stats" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Panel Margin="0,10,0,14">
      <!-- Logs: followed as they come -->
      <DockPanel IsVisible="{Binding IsLogs}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="280,*,Auto" Margin="0,0,0,8">
          <Panel>
            <TextBox Name="LogSearch" Classes="dkSearch" PlaceholderText="Search the logs (Enter finds the next)" KeyDown="OnLogSearchKeyDown" />
            <v:VsIcon Kind="Search" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="#9D9D9D" />
          </Panel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14">
            <CheckBox Content="Timestamps" IsChecked="{Binding Timestamps}" />
            <CheckBox Content="Wrap lines" IsChecked="{Binding WrapLogs}" />
            <Button Classes="dkIcon" Click="OnCopyLogs" ToolTip.Tip="Copy the logs">
              <v:VsIcon Kind="Copy" />
            </Button>
            <Button Classes="dkIcon" Command="{Binding ClearLogsCommand}" ToolTip.Tip="Clear (the container keeps them)">
              <v:VsIcon Kind="ClearAll" />
            </Button>
          </StackPanel>
        </Grid>
        <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
          <ae:TextEditor Name="LogsEditor" FontFamily="{StaticResource VsCodeFont}" FontSize="12" Background="#181818" Foreground="#D4D4D4"
                         Padding="10,6" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        </Border>
      </DockPanel>

      <!-- Inspect -->
      <Border IsVisible="{Binding IsInspect}" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <ae:TextEditor Name="InspectEditor" FontFamily="{StaticResource VsCodeFont}" FontSize="12" Background="#181818" Padding="10,6"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
      </Border>

      <!-- Bind mounts and volumes -->
      <DockPanel IsVisible="{Binding IsMounts}">
        <Border DockPanel.Dock="Top" Classes="dkTableHeader">
          <Grid ColumnDefinitions="90,*,*,110">
            <TextBlock Text="Type" Classes="dkHeader" Margin="8,0,0,0" />
            <TextBlock Grid.Column="1" Text="Source (host)" Classes="dkHeader" />
            <TextBlock Grid.Column="2" Text="Destination (container)" Classes="dkHeader" />
            <TextBlock Grid.Column="3" Text="Mode" Classes="dkHeader" />
          </Grid>
        </Border>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Mounts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dvm:MountItem">
                <Border Classes="dkRow" MinHeight="38">
                  <Grid ColumnDefinitions="90,*,*,110">
                    <TextBlock Classes="dkCell" Text="{Binding Type}" Margin="8,0,0,0" />
                    <Panel Grid.Column="1">
                      <Button Classes="dkLink" IsVisible="{Binding IsVolume}" ToolTip.Tip="The volume"
                              Command="{Binding $parent[UserControl].((dvm:ContainerDetailViewModel)DataContext).OpenVolumeCommand}" CommandParameter="{Binding}">
                        <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                      </Button>
                      <SelectableTextBlock Text="{Binding Source}" IsVisible="{Binding !IsVolume}" Classes="dkMono" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Panel>
                    <SelectableTextBlock Grid.Column="2" Text="{Binding Destination}" Classes="dkMono" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0" />
                    <TextBlock Grid.Column="3" Classes="dkCell" Text="{Binding ModeText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Nothing is mounted in this container." Classes="dkMuted" Margin="8,14" IsVisible="{Binding HasNoMounts}" />
        </StackPanel>
      </DockPanel>

      <!-- A shell in the container -->
      <Panel IsVisible="{Binding IsExec}">
        <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Background="#1E1E1E"
                IsVisible="{Binding Terminal, Converter={x:Static ObjectConverters.IsNotNull}}">
          <v:ControlPresenter Name="ExecHost" Control="{Binding Terminal.Control, FallbackValue={x:Null}}" Margin="6,4" />
        </Border>
        <StackPanel IsVisible="{Binding Terminal, Converter={x:Static ObjectConverters.IsNull}}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <v:VsIcon Kind="DockerTerminal" Width="36" Height="36" Foreground="#5A6270" HorizontalAlignment="Center" />
          <TextBlock Text="Start the container to open a shell in it." Classes="dkMuted" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>

      <!-- Live stats -->
      <ScrollViewer IsVisible="{Binding IsStats}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <TextBlock Text="Start the container to see what it uses." Classes="dkMuted" IsVisible="{Binding !Row.IsRunning}" />
          <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto" IsVisible="{Binding Row.IsRunning}">
            <Border Classes="dkCard">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="CPU usage" Classes="dkMuted" />
                  <TextBlock Grid.Column="1" Name="CpuStat" Text="{Binding Row.CpuText}" FontWeight="SemiBold" />
                </Grid>
                <dv:DockerChart Height="110" Values="{Binding Row.CpuHistory}" Version="{Binding Row.StatsVersion}" Color="#4E8DF5" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="dkCard">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Memory usage" Classes="dkMuted" />
                  <TextBlock Grid.Column="1" Text="{Binding Row.MemoryText}" FontWeight="SemiBold" />
                </Grid>
                <dv:DockerChart Height="110" Values="{Binding Row.MemoryHistory}" Version="{Binding Row.StatsVersion}" Color="#A371F7" />
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Classes="dkCard">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Disk read / write" Classes="dkMuted" />
                  <TextBlock Grid.Column="1" Text="{Binding Row.DiskRateText}" FontWeight="SemiBold" />
                </Grid>
                <Panel Height="110">
                  <dv:DockerChart Values="{Binding Row.DiskReadHistory}" Version="{Binding Row.StatsVersion}" Color="#3FB950" />
                  <dv:DockerChart Values="{Binding Row.DiskWriteHistory}" Version="{Binding Row.StatsVersion}" Color="#D29922" />
                </Panel>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="2" Classes="dkCard">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Network I/O" Classes="dkMuted" />
                  <TextBlock Grid.Column="1" Text="{Binding Row.NetRateText}" FontWeight="SemiBold" />
                </Grid>
                <Panel Height="110">
                  <dv:DockerChart Values="{Binding Row.NetReceiveHistory}" Version="{Binding Row.StatsVersion}" Color="#39C5CF" />
                  <dv:DockerChart Values="{Binding Row.NetSendHistory}" Version="{Binding Row.StatsVersion}" Color="#F778BA" />
                </Panel>
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock Text="{Binding Row.PidsText}" Classes="dkMuted" IsVisible="{Binding Row.IsRunning}" />
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
