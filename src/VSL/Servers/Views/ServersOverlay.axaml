<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:VSL.Views"
             xmlns:svm="using:VSL.Servers.ViewModels"
             xmlns:dvm="using:VSL.Docker.ViewModels"
             x:Class="VSL.Servers.Views.ServersOverlay"
             x:DataType="svm:ServersExplorerViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://VSL/Docker/Views/DockerStyles.axaml" />
  </UserControl.Styles>

  <!-- Over the window: the Servers explorer's dialogs and errors. Clicks pass through otherwise. -->
  <Panel>
    <Panel Name="DialogLayer" IsVisible="{Binding HasDialog}" Background="#99000000">
      <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="svm:SecretDialog">
            <Border Classes="dkCard" Width="440" Padding="22,18" Background="#2B2B2F">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Question}" TextWrapping="Wrap" Classes="dkMuted" />
                <TextBox Name="SecretBox" Classes="dkField" PasswordChar="•" RevealPassword="False" Text="{Binding Secret}" />
                <CheckBox Content="Keep it in the system keyring" IsChecked="{Binding Save}" IsVisible="{Binding CanSave}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                  <Button Classes="dkPrimary" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsDefault="True" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="svm:TrustDialog">
            <Border Classes="dkCard" Width="500" Padding="22,18" Background="#2B2B2F">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="dkMuted" />
                <Border Background="#181818" CornerRadius="5" Padding="10,8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding KeyType}" Classes="dkMuted" FontSize="11" />
                    <SelectableTextBlock Name="Fingerprint" Text="{Binding Fingerprint}" Classes="dkMono" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                  <Button Classes="dkPrimary" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="svm:ServerFormDialog">
            <Border Classes="dkCard" Width="520" Padding="22,18" Background="#2B2B2F">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="A ~/.ssh/config host: its address and key are its config's; VSL keeps its group and production flag."
                           TextWrapping="Wrap" Classes="dkMuted" IsVisible="{Binding IsFromSshConfig}" />
                <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Text="Name" Classes="dkMuted" />
                  <TextBox Name="ServerNameBox" Grid.Row="1" Classes="dkField" Text="{Binding Name}" PlaceholderText="web-1" IsEnabled="{Binding CanEditConnection}" />
                  <TextBlock Grid.Column="2" Text="Group" Classes="dkMuted" />
                  <AutoCompleteBox Grid.Row="1" Grid.Column="2" Text="{Binding Group}" ItemsSource="{Binding Groups}" Watermark="Work" FilterMode="StartsWith" />
                  <TextBlock Grid.Row="2" Text="Host" Classes="dkMuted" Margin="0,8,0,0" />
                  <TextBox Name="AddressBox" Grid.Row="3" Classes="dkField" Text="{Binding Address}" PlaceholderText="203.0.113.10 or example.com" IsEnabled="{Binding CanEditConnection}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="Port" Classes="dkMuted" Margin="0,8,0,0" />
                  <TextBox Grid.Row="3" Grid.Column="2" Classes="dkField" Text="{Binding Port}" IsEnabled="{Binding CanEditConnection}" />
                  <TextBlock Grid.Row="4" Text="User" Classes="dkMuted" Margin="0,8,0,0" />
                  <TextBox Name="UserBox" Grid.Row="5" Classes="dkField" Text="{Binding User}" IsEnabled="{Binding CanEditConnection}" />
                  <TextBlock Grid.Row="4" Grid.Column="2" Text="Private key (optional)" Classes="dkMuted" Margin="0,8,0,0" />
                  <TextBox Grid.Row="5" Grid.Column="2" Classes="dkField" Text="{Binding IdentityFile}" PlaceholderText="~/.ssh/id_ed25519" IsEnabled="{Binding CanEditConnection}" />
                  <CheckBox Grid.Row="6" Grid.ColumnSpan="3" Margin="0,10,0,0" IsChecked="{Binding Production}"
                            Content="Production: every change on it asks (yours and Claude's)" />
                  <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Margin="0,6,0,0" Classes="dkMuted" FontSize="11" TextWrapping="Wrap"
                             Text="Without a key VSL tries ~/.ssh/id_*, then asks for the password (kept for the session, or in the system keyring)." />
                </Grid>
                <TextBlock Text="{Binding Problem}" Foreground="#FF7B72" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                  <Button Name="SaveServerButton" Classes="dkPrimary" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsDefault="True"
                          IsEnabled="{Binding Problem, Converter={x:Static ObjectConverters.IsNull}}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="dvm:ConfirmDialog">
            <Border Classes="dkCard" Width="460" Padding="22,18" Background="#2B2B2F">
              <StackPanel Spacing="14">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="dkMuted" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                  <Button Classes="dkPrimary" Classes.dkDanger="{Binding IsDanger}" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsDefault="True" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="dvm:InputDialog">
            <Border Classes="dkCard" Width="420" Padding="22,18" Background="#2B2B2F">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding Label}" Classes="dkMuted" />
                  <TextBox Classes="dkField" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                  <Button Classes="dkPrimary" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsDefault="True" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Panel>

    <Border IsVisible="{Binding HasError}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" MaxWidth="480"
            Background="#3D1C1E" BorderBrush="#7A2E32" BorderThickness="1" CornerRadius="6" BoxShadow="0 4 16 0 #80000000">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,10,6,10">
        <v:VsIcon Kind="Error" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0" />
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock Text="Servers" FontWeight="SemiBold" Foreground="#FFB4AE" />
          <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#FFB4AE" />
        </StackPanel>
        <Button Grid.Column="2" Classes="dkIcon" Width="24" Height="24" VerticalAlignment="Top" Command="{Binding DismissErrorCommand}" ToolTip.Tip="Dismiss">
          <v:VsIcon Kind="Close" Width="12" Height="12" />
        </Button>
      </Grid>
    </Border>
  </Panel>
</UserControl>
