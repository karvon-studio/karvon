<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Karvon.Views"
             xmlns:prvm="using:Karvon.PullRequests.ViewModels"
             xmlns:prv="using:Karvon.PullRequests.Views"
             x:Class="Karvon.PullRequests.Views.PullRequestPageView"
             x:DataType="prvm:PullRequestPageViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon.Core/Themes/ExplorerStyles.axaml" />
    <Style Selector="ListBox#FileList ListBoxItem">
      <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Border.pill.purple">
      <Setter Property="Background" Value="#2E2340" />
    </Style>
    <Style Selector="Border.pill.purple TextBlock">
      <Setter Property="Foreground" Value="#C297F5" />
    </Style>
  </UserControl.Styles>

  <DockPanel Background="{StaticResource VsToolWindowBrush}">
    <!-- What it asks, how it stands, and what can be done with it -->
    <Border DockPanel.Dock="Top" Padding="20,14,20,0" BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <v:VsIcon Kind="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
          <SelectableTextBlock Name="Heading" Text="{Binding Heading}" FontSize="19" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Name="Facts" Text="{Binding Facts}" Classes="dkMuted" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal">
          <Border Classes="pill" Classes.green="{Binding IsOpen}" Classes.purple="{Binding IsMerged}" Classes.red="{Binding IsClosed}" Margin="0,0,8,6">
            <TextBlock Name="StatePill" Text="{Binding StateText}" />
          </Border>
          <TextBlock Text="{Binding Labels}" Classes="dkMuted" VerticalAlignment="Center" Margin="0,0,10,6" IsVisible="{Binding HasLabels}" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,6,6" IsVisible="{Binding IsOpen}">
            <ComboBox Name="MergeBox" ItemsSource="{Binding MergeChoices}" SelectedItem="{Binding Merge}" MinWidth="170" />
            <Button Name="MergeButton" Classes="dkPrimary" Content="Merge" Command="{Binding MergeCommand}" IsEnabled="{Binding CanMerge}" />
            <CheckBox Content="Delete the branch" IsChecked="{Binding DeleteBranch}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="dkOutline" Content="Close" Command="{Binding CloseCommand}" IsVisible="{Binding IsOpen}" Margin="0,0,6,6" />
          <Button Classes="dkOutline" Content="Check Out" Command="{Binding CheckoutCommand}" IsVisible="{Binding IsOpen}" Margin="0,0,6,6"
                  ToolTip.Tip="Its branch checked out here" />
          <Button Classes="dkOutline" Content="Open in Browser" Command="{Binding OpenInBrowserCommand}" Margin="0,0,6,6" />
          <Button Classes="dkOutline" Command="{Binding AskClaudeCommand}" Margin="0,0,6,6" ToolTip.Tip="Claude Code reviews it with its pull request tools">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:VsIcon Kind="Claude" Width="14" Height="14" />
              <TextBlock Text="Ask Claude to Review" />
            </StackPanel>
          </Button>
          <Button Classes="tbi" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" Margin="0,0,6,6"><v:VsIcon Kind="Refresh" /></Button>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" Height="3" MinWidth="0" VerticalAlignment="Center" Margin="0,0,0,6" />
        </WrapPanel>
        <TextBlock Name="MergeNote" Text="{Binding MergeNote}" Foreground="#CCA700" TextWrapping="Wrap" IsVisible="{Binding HasMergeNote}" />
        <TextBlock Name="Error" Text="{Binding Error}" Foreground="#F14C4C" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal">
          <Button Name="ConversationTab" Classes="dkTab" Classes.selected="{Binding IsConversation}" Command="{Binding ShowTabCommand}" CommandParameter="conversation" Content="Conversation" />
          <Button Name="FilesTab" Classes="dkTab" Classes.selected="{Binding IsFiles}" Command="{Binding ShowTabCommand}" CommandParameter="files" Content="{Binding FilesHeader}" />
          <Button Name="ChecksTab" Classes="dkTab" Classes.selected="{Binding IsChecks}" Command="{Binding ShowTabCommand}" CommandParameter="checks" Content="{Binding ChecksHeader}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Panel>
      <!-- The conversation: the description, the comments, a new one; the reviewers' say beside it -->
      <DockPanel IsVisible="{Binding IsConversation}">
        <Border DockPanel.Dock="Right" Width="260" BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="1,0,0,0" Padding="16,12">
          <StackPanel Spacing="8">
            <TextBlock Text="Reviewers" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ReviewersText}" Classes="dkMuted" TextWrapping="Wrap" IsVisible="{Binding ReviewersText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="No reviews yet." Classes="dkMuted" IsVisible="{Binding !HasReviews}" />
            <ItemsControl Name="Reviews" ItemsSource="{Binding Reviews}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="prvm:ReviewRow">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                    <v:VsIcon Kind="{Binding Icon}" Width="13" Height="13" />
                    <TextBlock><Run Text="{Binding Author}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Text}" Foreground="#9D9D9D" /></TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20,14" Spacing="10">
            <Border Background="#2D2D30" CornerRadius="4" Padding="12,8">
              <v:MarkdownView Name="Description" Markdown="{Binding Body}" />
            </Border>
            <ItemsControl Name="Comments" ItemsSource="{Binding Comments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="prvm:CommentRow">
                  <Border Background="#2D2D30" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <TextBlock><Run Text="{Binding Author}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding When}" Foreground="#9D9D9D" /></TextBlock>
                      <TextBlock Text="{Binding Where}" IsVisible="{Binding HasWhere}" Foreground="#4DAAFC" FontSize="11" />
                      <v:MarkdownView Markdown="{Binding Body}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Name="NewComment" Classes="dkField" Text="{Binding NewComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                     PlaceholderText="Add a comment, or what your review says…" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="dkPrimary" Content="Comment" Command="{Binding CommentCommand}" />
              <Button Classes="dkOutline" Content="Approve" Command="{Binding ApproveCommand}" IsVisible="{Binding IsOpen}" />
              <Button Classes="dkOutline" Content="Request Changes" Command="{Binding RequestChangesCommand}" IsVisible="{Binding IsOpen}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- Its files: each opens as a diff -->
      <ListBox Name="FileList" ItemsSource="{Binding Files}" Background="Transparent" IsVisible="{Binding IsFiles}" Margin="10,8"
               DoubleTapped="OnFileDoubleTapped" KeyDown="OnFileKeyDown">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="prvm:FileRow">
            <Grid ColumnDefinitions="22,Auto,*,Auto">
              <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" Foreground="{Binding Letter, Converter={x:Static prv:PullRequestConverters.LetterBrush}}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" />
              <TextBlock Grid.Column="2" Text="{Binding Folder}" Classes="dkMuted" FontSize="11" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Counts}" Classes="dkMuted" FontSize="11" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Its head commit's checks -->
      <ScrollViewer IsVisible="{Binding IsChecks}">
        <StackPanel Margin="20,14" Spacing="4">
          <TextBlock Text="No checks ran on it." Classes="dkMuted" IsVisible="{Binding !HasChecks}" />
          <ItemsControl Name="Checks" ItemsSource="{Binding Checks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="prvm:CheckRow">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="26">
                  <v:VsIcon Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="dkMuted" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                  <Button Grid.Column="3" Classes="dkLink" Content="Details" Command="{Binding $parent[UserControl].((prvm:PullRequestPageViewModel)DataContext).OpenCheckCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
