<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Karvon.Ui"
             xmlns:pvm="using:Karvon.Pipelines.ViewModels"
             xmlns:prvm="using:Karvon.PullRequests.ViewModels"
             x:Class="Karvon.PullRequests.Views.PullRequestsOverlay"
             x:DataType="prvm:PullRequestsViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Karvon.Core/Themes/ExplorerStyles.axaml" />
  </UserControl.Styles>

  <!-- Over the window: the Pull Requests window's dialog. Clicks pass through otherwise. -->
  <Panel Name="DialogLayer" IsVisible="{Binding HasDialog}" Background="#99000000">
    <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="prvm:NewPullRequestDialog">
          <Border Classes="dkCard" Width="600" Padding="22,18" Background="#2B2B2F">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Explanation}" Classes="dkMuted" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
                <StackPanel Spacing="4">
                  <TextBlock Text="From" Classes="dkMuted" />
                  <TextBox Classes="dkField" Text="{Binding Source}" IsReadOnly="True" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="Into" Classes="dkMuted" />
                  <TextBox Name="TargetBox" Classes="dkField" Text="{Binding Target}" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Title" Classes="dkMuted" Margin="0,4,0,0" />
              <TextBox Name="TitleBox" Classes="dkField" Text="{Binding Title}" />
              <TextBlock Text="Description" Classes="dkMuted" Margin="0,4,0,0" />
              <TextBox Name="BodyBox" Classes="dkField" Text="{Binding Body}" AcceptsReturn="True" TextWrapping="Wrap" Height="140" />
              <CheckBox Content="A draft (not ready for review yet)" IsChecked="{Binding Draft}" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                <Button Classes="dkPrimary" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
        <DataTemplate DataType="pvm:PipelineTokenDialog">
          <Border Classes="dkCard" Width="520" Padding="22,18" Background="#2B2B2F">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Explanation}" Classes="dkMuted" TextWrapping="Wrap" />
              <TextBlock Text="Token" Classes="dkMuted" Margin="0,4,0,0" />
              <TextBox Name="TokenBox" Classes="dkField" PasswordChar="•" RevealPassword="False" Text="{Binding Token}" />
              <Button Classes="dkLink" Command="{Binding ShowTokenPageCommand}" HorizontalAlignment="Left" Content="Make one with the scopes it needs" />
              <CheckBox Content="Keep it in the system keyring" IsChecked="{Binding Keep}" IsVisible="{Binding CanKeep}" />
              <TextBlock Text="Without a keyring, Karvon asks for it once a session." Classes="dkMuted" FontSize="11" IsVisible="{Binding !CanKeep}" />
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                <Button Classes="dkOutline" Command="{Binding ForgetTokenCommand}" Content="Forget Token" IsVisible="{Binding HasToken}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                  <Button Classes="dkPrimary" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" IsDefault="True" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
        <DataTemplate DataType="ui:ConfirmDialog">
          <Border Classes="dkCard" Width="460" Padding="22,18" Background="#2B2B2F">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="dkMuted" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="dkOutline" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                <Button Classes="dkPrimary" Classes.dkDanger="{Binding IsDanger}" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" IsDefault="True" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Panel>
</UserControl>
