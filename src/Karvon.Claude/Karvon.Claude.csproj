<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Claude Code module: the CLI's conversation in a tool window, and Karvon's tools for it. The session, protocol and
       view model (the folder's root and ViewModels/) use neither Avalonia nor the module contract; the module itself is
       in Module/. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Karvon.Claude</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Karvon.Tests" />
    <InternalsVisibleTo Include="Karvon.Bench" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Karvon.Core\Karvon.Core.csproj" />
  </ItemGroup>
</Project>
