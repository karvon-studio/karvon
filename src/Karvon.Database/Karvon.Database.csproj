<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Database Explorer module: Bengine Data Studio's explorer, its documents and Claude Code's database tools. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Karvon.Database</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Karvon.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Its icons and SQL / Mongo shell highlighting. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Bengine's schema AST and its live-database layer (the bengine repository, a submodule). -->
    <ProjectReference Include="..\..\external\bengine\src\Bengine\Bengine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Karvon.Core\Karvon.Core.csproj" />
  </ItemGroup>
</Project>
